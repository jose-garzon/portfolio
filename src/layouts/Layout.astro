---
import '../styles/global.css';

import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Header from '../shared/components/Header/Header';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description = 'Backend-leaning software engineer. Systems, databases, and writing in public.',
  type = 'website',
  publishedTime,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="alternate" type="application/rss+xml" title="jose-garzon.dev" href="/rss.xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="jose-garzon.dev" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Saira+Stencil+One&family=Silkscreen:wght@400;700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans+Condensed:wght@500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header client:load pathname={Astro.url.pathname} />
    <slot />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );

      document
        .querySelectorAll('.reveal, .reveal-stagger > *')
        .forEach((el) => observer.observe(el));

      const glitchObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            el.classList.add('is-glitching');
            el.addEventListener('animationend', () => el.classList.remove('is-glitching'), { once: true });
            glitchObserver.unobserve(el);
          });
        },
        { threshold: 0.6 }
      );

      document
        .querySelectorAll('main h2, main h3')
        .forEach((el) => {
          if (!el.closest('article, li, aside, .prose')) glitchObserver.observe(el);
        });
    </script>
  </body>
</html>

