---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Badge from '../../shared/components/Badge.astro';
import PageHead from '../../shared/components/PageHead.astro';
import { fullName } from '../../shared/data/personal';
import { projects } from '../../shared/data/projects';

const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/*.png', {
  eager: true,
});
const shotOf = (file?: string) =>
  file ? shots[`../../assets/projects/${file}`]?.default : undefined;
const writeups = projects.filter((p) => p.slug).length;
const stackSize = new Set(projects.flatMap((p) => p.stack)).size;
const isRepo = (url?: string) =>
  !!url && new URL(url).pathname.split('/').filter(Boolean).length > 1;
---

<Layout
  title={`Projects · ${fullName}`}
  description="AI agents, offline desktop tools and local-first apps by Jose Garzón, with write-ups on the problem, the approach, and what broke."
>
  <main id="main" class="projects-main">
    <div class="container">
      <PageHead
        title="Built, broken, rebuilt"
        lede="AI agents, offline desktop tools, local-first apps. Four of these have a full write-up: the problem, the approach, what broke, what I'd change."
        readouts={[
          { label: 'projects', value: projects.length },
          { label: 'write-ups', value: writeups },
          { label: 'tools used', value: stackSize },
        ]}
      />

      <ol class="project-feed">
        {projects.map((project) => {
          const href = project.slug
            ? `/projects/${project.slug}`
            : (project.href ?? project.github);
          const external = !project.slug && !project.href;
          const route = project.slug
            ? 'case study →'
            : project.href
              ? `${project.cta ?? 'open'} →`
              : 'github ↗';
          const shot = shotOf(project.image);
          const titleId = `project-${project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
          return (
            <li class:list={['project-row', { 'project-row--shot': shot }]}>
              <div class="project-body">
              <p class="project-meta">
                <span class="project-kind">{project.kind}</span>
                <span class="project-route" aria-hidden="true">{route}</span>
              </p>
              <h2 class="project-row-title" id={titleId}>
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener' : undefined}
                  class="project-link"
                >
                  {project.name}
                  {external && <span class="sr-only"> (opens in new tab)</span>}
                </a>
              </h2>
              <p class="project-row-desc">{project.description}</p>
              {project.signal && <p class="project-signal">{project.signal}</p>}
              <ul class="project-row-stack" aria-label="Stack">
                {project.stack.map((tech) => (
                  <li><Badge>{tech}</Badge></li>
                ))}
              </ul>
              {(project.live || (project.slug && isRepo(project.github))) && (
                <p class="project-extras">
                  {project.live && (
                    <a href={project.live} target="_blank" rel="noopener" aria-describedby={titleId}>
                      live ↗<span class="sr-only"> (opens in new tab)</span>
                    </a>
                  )}
                  {project.slug && isRepo(project.github) && (
                    <a href={project.github} target="_blank" rel="noopener" aria-describedby={titleId}>
                      github ↗<span class="sr-only"> (opens in new tab)</span>
                    </a>
                  )}
                </p>
              )}
              </div>
              {shot && (
                <div class="project-shot-frame">
                <Image
                  src={shot}
                  alt=""
                  widths={[360, 720]}
                  sizes="(max-width: 860px) 100vw, 360px"
                  class="project-shot"
                  loading="lazy"
                />
                </div>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </main>
</Layout>

<style>
  .projects-main {
    padding-top: calc(var(--nav-height) + var(--space-12));
    padding-bottom: var(--space-section);
  }

  .project-feed {
    list-style: none;
    margin-inline: calc(-1 * var(--space-4));
    border-top: 1px solid var(--color-border);
  }

  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    align-items: stretch;
    padding: var(--space-8) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-normal) var(--ease-out);
  }

  .project-row--shot {
    grid-template-columns: minmax(0, 1fr) 360px;
  }

  .project-body {
    display: grid;
    gap: var(--space-3);
  }

  .project-shot-frame {
    position: relative;
    min-height: 220px;
    margin-block: calc(-1 * var(--space-8));
    margin-right: calc(-1 * var(--space-4));
    overflow: hidden;
    border-left: 1px solid var(--color-border);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .project-shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: grayscale(0.6) brightness(0.85);
    transition: filter var(--duration-normal) var(--ease-out);
  }

  .project-row:hover .project-shot-frame {
    border-color: var(--color-cyan);
  }

  .project-row:hover .project-shot {
    filter: none;
  }

  .project-signal {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .project-signal::before {
    content: "> ";
    color: var(--color-accent);
  }

  .project-row:hover {
    background: var(--color-surface-raised);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .project-kind {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .project-route {
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease;
  }

  .project-row-title {
    font-family: var(--font-condensed);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .project-link {
    color: var(--color-text);
    transition: color var(--duration-fast) ease;
  }

  .project-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .project-link:focus-visible {
    outline: none;
  }

  .project-row:has(.project-link:focus-visible) {
    outline: 2px solid var(--color-cyan);
    outline-offset: -2px;
  }

  .project-row:hover .project-link,
  .project-row:hover .project-route {
    color: var(--color-cyan);
  }

  .project-row-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 62ch;
  }

  .project-row-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-top: var(--space-1);
  }

  .project-row-stack :global(.badge:hover) {
    transform: none;
  }

  .project-extras {
    position: relative;
    z-index: 1;
    display: flex;
    gap: var(--space-5);
    width: fit-content;
  }

  .project-extras a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-cyan);
  }

  .project-extras a:hover {
    color: var(--color-text);
  }

  @media (max-width: 860px) {
    .project-row--shot {
      grid-template-columns: minmax(0, 1fr);
    }

    .project-shot-frame {
      order: -1;
      min-height: 0;
      margin: 0;
      border: 1px solid var(--color-border);
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 640px) {
    .project-row {
      padding-block: var(--space-6);
    }
  }
</style>
