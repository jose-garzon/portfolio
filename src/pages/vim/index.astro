---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { levels } from '../../modules/vim-tutorial/levels';
import { countExercises } from '../../modules/vim-tutorial/progress';
import '../../modules/vim-tutorial/vim.css';
import { fullName } from '../../shared/data/personal';

const intro = await getEntry('vim', 'vim-intro');
if (!intro) throw new Error('Missing vim-intro entry in the vim collection');
const { Content } = await render(intro);
const { title, summary } = intro.data;

const entries = await getCollection('vim');
const byId = new Map(entries.map((e) => [e.id, e]));
const counts = Object.fromEntries(
  levels.map((lvl) => [lvl.slug, countExercises(byId.get(lvl.collectionId)?.body)]),
);
const totalExercises = Object.values(counts).reduce((a, b) => a + b, 0);
---

<Layout
  title={`Vim · ${fullName}`}
  description={summary ?? 'An interactive, level-by-level path to learning Vim.'}
>
  <main id="main" class="vim-index vim-page">
    <div class="container">
      <header class="vim-index-header">
        <p class="section-label">interactive tutorial</p>
        <h1 class="vim-index-title">
          <span data-text={title}>{title}</span>
        </h1>
        {summary && <p class="vim-index-subtext">{summary}</p>}
        <p class="vim-index-meta data-tag">
          {levels.length} levels · {totalExercises} exercises · real vim keymap in the browser
        </p>
        <div class="breach-readout">
          <p class="breach-count data-tag">
            <span data-breach-count>0</span>/{levels.length} nodes breached
          </p>
          <ol class="breach-bar" aria-hidden="true">
            {levels.map((lvl) => <li data-segment-for={lvl.slug}></li>)}
          </ol>
        </div>
      </header>

      <div class="vim-prose">
        <Content />
      </div>

      <section class="levels" aria-labelledby="levels-heading">
        <h2 id="levels-heading" class="section-label">levels</h2>
        <ol class="breach-map">
          {levels.map((lvl) => (
            <li class="node" data-node={lvl.slug}>
              <a href={`/vim/${lvl.slug}`} class="node-link">
                <span class="node-chip cut">{String(lvl.level).padStart(2, '0')}</span>
                <span class="level-body">
                  <span class="node-flag data-tag">next target</span>
                  <span class="level-title">{lvl.title}</span>
                  <span class="level-summary">{lvl.summary}</span>
                </span>
                <span class="vim-progress" data-progress-for={lvl.slug} data-total={counts[lvl.slug]}></span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </main>
</Layout>

<script>
  import '../../modules/vim-tutorial/progress-ui';
</script>

<style>
  .vim-index {
    padding-top: calc(var(--nav-height) + var(--space-12));
    padding-bottom: var(--space-section);
  }

  .vim-index-header {
    max-width: var(--max-prose);
    margin-bottom: var(--space-10);
  }

  .vim-index-title {
    text-transform: uppercase;
    font-size: var(--text-5xl);
    color: var(--color-text);
    letter-spacing: 0.01em;
    line-height: 0.92;
    margin-bottom: var(--space-4);
  }

  .vim-index-subtext {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: var(--space-4);
  }

  .vim-index-meta {
    color: var(--color-cyan);
  }

  .levels {
    max-width: var(--max-prose);
    margin-top: var(--space-section);
  }

  .breach-readout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-5);
  }

  .breach-count {
    color: var(--color-text-subtle);
  }

  .breach-count [data-breach-count] {
    color: var(--color-text);
  }

  .breach-bar {
    display: flex;
    gap: 3px;
    list-style: none;
  }

  .breach-bar li {
    width: 18px;
    height: 8px;
    border: 1px solid var(--color-border);
    transform: skewX(-20deg);
  }

  .breach-bar li[data-state='partial'] {
    border-color: var(--color-cyan-deep);
    background: var(--color-cyan-dim);
  }

  .breach-bar li[data-state='done'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .breach-map {
    --chip: 3.5rem;
    --rail-x: calc(var(--space-2) + var(--chip) / 2);
    list-style: none;
  }

  .node {
    position: relative;
  }

  .node::before {
    content: "";
    position: absolute;
    left: var(--rail-x);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
  }

  .node:first-child::before {
    top: 50%;
  }

  .node:last-child::before {
    bottom: 50%;
  }

  .node[data-state='done']:not(:last-child)::before {
    background: var(--color-accent);
  }

  .node-link {
    position: relative;
    display: grid;
    grid-template-columns: var(--chip) 1fr auto;
    align-items: center;
    column-gap: var(--space-5);
    padding: var(--space-5) var(--space-2);
    color: inherit;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .node-link:hover {
    background: var(--color-surface);
  }

  .node-chip {
    --cut: 10px;
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--chip);
    aspect-ratio: 1;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--color-text-subtle);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      var(--color-border);
    border: 1px solid transparent;
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .node[data-state='partial'] .node-chip {
    color: var(--color-cyan);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      var(--color-cyan-deep);
  }

  .node[data-state='done'] .node-chip {
    color: var(--color-bg);
    background: var(--color-accent);
  }

  .node[data-next] .node-chip {
    color: var(--color-cyan);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      var(--color-cyan);
    animation: target-lock 520ms steps(4, end) 400ms both;
  }

  .node-link:hover .node-chip {
    color: var(--color-cyan);
  }

  .node[data-state='done'] .node-link:hover .node-chip {
    color: var(--color-bg);
    background: var(--color-cyan);
  }

  @keyframes target-lock {
    0% { transform: scale(1.6); opacity: 0; }
    50% { transform: scale(1.15); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }

  .node-flag {
    display: none;
    color: var(--color-cyan);
  }

  .node-flag::before {
    content: "> " / "";
  }

  .node[data-next] .node-flag {
    display: block;
  }

  .level-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .level-title {
    font-family: var(--font-condensed);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    transition: color var(--duration-fast) ease;
  }

  .node-link:hover .level-title {
    color: var(--color-cyan);
  }

  .level-summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  @media (max-width: 480px) {
    .breach-map {
      --chip: 2.75rem;
    }

    .node-link {
      grid-template-columns: var(--chip) 1fr;
    }

    .node-link .vim-progress {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node[data-next] .node-chip {
      animation: none;
    }
  }
</style>
