---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { levels } from '../../modules/vim-tutorial/levels';
import { fullName } from '../../shared/data/personal';

const intro = await getEntry('vim', 'vim-intro');
const { Content } = await render(intro!);
const { title, summary } = intro!.data;
---

<Layout
  title={`Vim — ${fullName}`}
  description={summary ?? 'An interactive, level-by-level path to learning Vim.'}
>
  <main class="vim-index">
    <div class="container">
      <header class="vim-index-header">
        <p class="kicker">
          <span class="kicker-prefix" aria-hidden="true">//</span>
          interactive tutorial
        </p>
        <h1 class="vim-index-title scanlines">
          <span data-text={title}>{title}</span>
        </h1>
        {summary && <p class="vim-index-subtext">{summary}</p>}
      </header>

      <div class="prose">
        <Content />
      </div>

      <section class="levels" aria-labelledby="levels-heading">
        <p id="levels-heading" class="levels-kicker">
          <span class="levels-kicker-prefix" aria-hidden="true">//</span>
          levels
        </p>
        <ol class="level-feed">
          {levels.map((lvl) => (
            <li class="level-row">
              <a href={`/vim/${lvl.slug}`} class="level-link">
                <span class="level-index" aria-hidden="true">
                  {String(lvl.level).padStart(2, '0')}
                </span>
                <span class="level-body">
                  <span class="level-title">{lvl.title}</span>
                  <span class="level-summary">{lvl.summary}</span>
                </span>
                <span class="level-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </main>
</Layout>

<style>
  .vim-index {
    padding-top: calc(var(--nav-height) + var(--space-12));
    padding-bottom: var(--space-section);
  }

  .vim-index-header {
    max-width: var(--max-prose);
    margin-bottom: var(--space-10);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-4);
  }

  .kicker-prefix {
    color: var(--color-accent);
  }

  .vim-index-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .vim-index-subtext {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .levels {
    max-width: var(--max-prose);
    margin-top: var(--space-section);
  }

  .levels-kicker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: var(--space-5);
  }

  .levels-kicker-prefix {
    color: var(--color-accent);
  }

  .level-feed {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .level-row {
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-normal) var(--ease-out);
  }

  .level-row:hover {
    background: var(--color-surface);
  }

  .level-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: var(--space-5);
    padding: var(--space-5) var(--space-2);
    color: inherit;
  }

  .level-index {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    letter-spacing: 0.06em;
  }

  .level-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .level-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    transition: color var(--duration-fast) ease;
  }

  .level-link:hover .level-title {
    color: var(--color-accent);
  }

  .level-summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .level-arrow {
    font-family: var(--font-mono);
    color: var(--color-text-subtle);
    transition:
      color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .level-link:hover .level-arrow {
    color: var(--color-accent);
    transform: translateX(3px);
  }
</style>

<style is:global>
  .vim-index .prose {
    max-width: var(--max-prose);
    line-height: 1.8;
    color: var(--color-text);
    font-size: var(--text-base);
  }

  .vim-index .prose h2 {
    color: var(--color-text);
    font-weight: 700;
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .vim-index .prose p {
    margin-bottom: var(--space-5);
  }

  .vim-index .prose strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .vim-index .prose ul {
    list-style: disc;
    padding-left: var(--space-6);
    margin-bottom: var(--space-5);
  }

  .vim-index .prose li {
    margin-bottom: var(--space-2);
  }

  .vim-index .prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    padding: 0.15em 0.45em;
    border-radius: var(--radius-sm);
  }
</style>
