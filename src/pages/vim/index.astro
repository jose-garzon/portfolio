---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { levels } from '../../modules/vim-tutorial/levels';
import { countExercises } from '../../modules/vim-tutorial/progress';
import '../../modules/vim-tutorial/vim.css';
import { fullName } from '../../shared/data/personal';

const intro = await getEntry('vim', 'vim-intro');
const { Content } = await render(intro!);
const { title, summary } = intro!.data;

const entries = await getCollection('vim');
const byId = new Map(entries.map((e) => [e.id, e]));
const counts = Object.fromEntries(
  levels.map((lvl) => [lvl.slug, countExercises(byId.get(lvl.collectionId)?.body)]),
);
const totalExercises = Object.values(counts).reduce((a, b) => a + b, 0);
---

<Layout
  title={`Vim · ${fullName}`}
  description={summary ?? 'An interactive, level-by-level path to learning Vim.'}
>
  <main id="main" class="vim-index vim-page">
    <div class="container">
      <header class="vim-index-header">
        <p class="section-label">interactive tutorial</p>
        <h1 class="vim-index-title">
          <span data-text={title}>{title}</span>
        </h1>
        {summary && <p class="vim-index-subtext">{summary}</p>}
        <p class="vim-index-meta data-tag">
          {levels.length} levels · {totalExercises} exercises · real vim keymap in the browser
        </p>
      </header>

      <div class="vim-prose">
        <Content />
      </div>

      <section class="levels" aria-labelledby="levels-heading">
        <h2 id="levels-heading" class="section-label">levels</h2>
        <ol class="level-feed">
          {levels.map((lvl) => (
            <li class="level-row">
              <a href={`/vim/${lvl.slug}`} class="level-link">
                <span class="level-index">{String(lvl.level).padStart(2, '0')}</span>
                <span class="level-body">
                  <span class="level-title">{lvl.title}</span>
                  <span class="level-summary">{lvl.summary}</span>
                </span>
                <span class="vim-progress" data-progress-for={lvl.slug} data-total={counts[lvl.slug]}></span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </main>
</Layout>

<script>
  import '../../modules/vim-tutorial/progress-ui';
</script>

<style>
  .vim-index {
    padding-top: calc(var(--nav-height) + var(--space-12));
    padding-bottom: var(--space-section);
  }

  .vim-index-header {
    max-width: var(--max-prose);
    margin-bottom: var(--space-10);
  }

  .vim-index-title {
    text-transform: uppercase;
    font-size: var(--text-5xl);
    color: var(--color-text);
    letter-spacing: 0.01em;
    line-height: 0.92;
    margin-bottom: var(--space-4);
  }

  .vim-index-subtext {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: var(--space-4);
  }

  .vim-index-meta {
    color: var(--color-cyan);
  }

  .levels {
    max-width: var(--max-prose);
    margin-top: var(--space-section);
  }

  .level-feed {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .level-row {
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-normal) var(--ease-out);
  }

  .level-row:hover {
    background: var(--color-surface);
  }

  .level-link {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    align-items: center;
    column-gap: var(--space-5);
    padding: var(--space-5) var(--space-2);
    color: inherit;
  }

  .level-index {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-text-subtle);
    transition: -webkit-text-stroke-color var(--duration-fast) ease;
  }

  .level-link:hover .level-index {
    -webkit-text-stroke-color: var(--color-cyan);
  }

  .level-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .level-title {
    font-family: var(--font-condensed);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    transition: color var(--duration-fast) ease;
  }

  .level-link:hover .level-title {
    color: var(--color-cyan);
  }

  .level-summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  @media (max-width: 480px) {
    .level-link {
      grid-template-columns: 2.5rem 1fr;
    }

    .level-index {
      font-size: var(--text-3xl);
    }

    .level-link .vim-progress {
      grid-column: 2;
    }
  }
</style>
