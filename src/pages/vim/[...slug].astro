---
import { getCollection, render } from 'astro:content';
import VimLevelLayout from '../../modules/vim-tutorial/components/VimLevelLayout.astro';
import { levels } from '../../modules/vim-tutorial/levels';
import { countExercises } from '../../modules/vim-tutorial/progress';

export async function getStaticPaths() {
  const entries = await getCollection('vim');
  const byId = new Map(entries.map((e) => [e.id, e]));
  const counts = Object.fromEntries(
    levels.map((lvl) => [lvl.slug, countExercises(byId.get(lvl.collectionId)?.body)]),
  );

  return levels.map((lvl, i) => {
    const prev = levels[i - 1];
    const next = levels[i + 1];
    return {
      params: { slug: lvl.slug },
      props: {
        entry: byId.get(lvl.collectionId),
        level: lvl,
        counts,
        prev: prev ? { slug: prev.slug, title: prev.title } : undefined,
        next: next ? { slug: next.slug, title: next.title } : undefined,
      },
    };
  });
}

const { entry, level, counts, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<VimLevelLayout
  title={level.title}
  summary={level.summary}
  level={level.level}
  counts={counts}
  prev={prev}
  next={next}
>
  <Content />
</VimLevelLayout>
