---
import Layout from '../layouts/Layout.astro';
import { experience } from '../shared/data/experience';
import { fullName } from '../shared/data/personal';
import Badge from '../shared/components/Badge.astro';
---

<Layout
  title={`Experience — ${fullName}`}
  description="Where I've shipped. Five years of production work at Disney, Aeroméxico, and earlier."
>
  <main class="experience-main">
    <div class="container">
      <header class="experience-header">
        <p class="kicker">
          <span class="kicker-prefix" aria-hidden="true">//</span>
          03 experience
        </p>
        <h1 class="experience-title scanlines">
          <span data-text="Work history">Work history</span>
        </h1>
        <p class="experience-subtext">
          Five years of production work. Microfrontend platforms, BFFs, microservices.
          The frontend half of systems I am now learning to build the backend half of.
        </p>
      </header>

      <ol class="timeline">
        {experience.map((job, i) => (
          <li class="timeline-item">
            <div class="timeline-indicator" aria-hidden="true">
              <div class="timeline-dot"></div>
              {i < experience.length - 1 && <div class="timeline-line"></div>}
            </div>
            <article class="job">
              <header class="job-header">
                <div>
                  <h2 class="job-role">{job.role}</h2>
                  <p class="job-company">{job.company}</p>
                </div>
                <span class="job-period">{job.period}</span>
              </header>

              <p class="job-description">{job.description}</p>

              <ul class="job-bullets">
                {job.bullets.map((bullet) => (
                  <li>
                    <span class="bullet-marker" aria-hidden="true">▸</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <ul class="job-stack">
                {job.stack.map((tech) => (
                  <li><Badge variant="accent">{tech}</Badge></li>
                ))}
              </ul>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </main>
</Layout>

<style>
  .experience-main {
    padding-top: calc(var(--nav-height) + var(--space-12));
    padding-bottom: var(--space-section);
  }

  .experience-header {
    max-width: 720px;
    margin-bottom: var(--space-12);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-4);
  }

  .kicker-prefix {
    color: var(--color-accent);
  }

  .experience-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .experience-subtext {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .timeline {
    list-style: none;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 28px 1fr;
    column-gap: var(--space-6);
    padding-bottom: var(--space-12);
  }

  .timeline-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--space-2);
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    background: var(--color-bg);
    flex-shrink: 0;
  }

  .timeline-line {
    width: 1px;
    flex-grow: 1;
    background: linear-gradient(to bottom, var(--color-border), transparent);
    margin-top: var(--space-2);
    min-height: var(--space-12);
  }

  .job {
    padding-bottom: var(--space-6);
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .job-role {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-1) 0;
    letter-spacing: -0.02em;
  }

  .job-company {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin: 0;
    font-weight: 500;
  }

  .job-period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    flex-shrink: 0;
  }

  .job-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.7;
    margin-bottom: var(--space-5);
    max-width: 65ch;
  }

  .job-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .job-bullets li {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.6;
    align-items: baseline;
  }

  .bullet-marker {
    color: var(--color-accent);
    font-size: 0.6em;
    flex-shrink: 0;
    translate: 0 0.15em;
  }

  .job-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 20px 1fr;
      column-gap: var(--space-4);
    }
  }
</style>
