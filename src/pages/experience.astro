---
import Layout from '../layouts/Layout.astro';
import Badge from '../shared/components/Badge.astro';
import ContactClose from '../modules/home/components/ContactClose.astro';
import { experience } from '../shared/data/experience';
import { fullName } from '../shared/data/personal';

const pad = (n: number) => String(n).padStart(2, '0');
const metricPattern = /(\d+%|in half)/;
const splitMetrics = (text: string) => text.split(metricPattern);

const seen = new Set<string>();
const stacks = experience.map((job) =>
  job.stack.filter((tech) => !seen.has(tech) && seen.add(tech))
);
---

<Layout
  title={`Experience · ${fullName}`}
  description="Where I've shipped. Five years of production work at Aeroméxico, Disney, Growie, and Serempre."
>
  <main id="main" class="experience-main">
    <div class="container">
      <header class="experience-header">
        <p class="section-label">experience</p>
        <h1 class="experience-title">
          <span data-text="Work history">Work history</span>
        </h1>
        <p class="experience-subtext">
          Software engineer with five years of production work: multi-team platform
          architecture, Backends for Frontends, and API contracts negotiated across teams.
        </p>
      </header>

      <ol class="timeline" reversed>
        {experience.map((job, i) => {
          return (
            <li class:list={['job', { 'job--current cut': i === 0 }]}>
              <span class="job-index" aria-hidden="true">{pad(experience.length - i)}</span>
              <article class="job-body">
                <header class="job-header">
                  <div>
                    <h2 class="job-role">{job.role}</h2>
                    <p class="job-company">{job.company}</p>
                  </div>
                  <p class="job-period data-tag">{job.period}</p>
                </header>

                <p class="job-description">{job.description}</p>

                <ul class="job-bullets">
                  {job.bullets.map((bullet, b) => (
                    <li class:list={{ 'job-bullet--lead': b === 0 }}>
                      {splitMetrics(bullet).map((part, k) =>
                        k % 2 ? <strong class="job-metric">{part}</strong> : part
                      )}
                    </li>
                  ))}
                </ul>

                <ul class="job-stack" aria-label="Stack">
                  {stacks[i].map((tech) => (
                    <li><Badge>{tech}</Badge></li>
                  ))}
                </ul>
              </article>
            </li>
          );
        })}
      </ol>

    </div>

    <ContactClose />
  </main>
</Layout>

<style>
  .experience-main {
    padding-top: calc(var(--nav-height) + var(--space-12));
  }

  .experience-header {
    max-width: 720px;
    margin-bottom: var(--space-12);
  }

  .experience-title {
    text-transform: uppercase;
    font-size: var(--text-5xl);
    color: var(--color-text);
    letter-spacing: 0.01em;
    line-height: 0.92;
    text-wrap: balance;
    margin-bottom: var(--space-4);
  }

  .experience-subtext {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .timeline {
    list-style: none;
    margin-bottom: var(--space-section);
    border-top: 1px solid var(--color-border);
  }

  .job {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    column-gap: var(--space-6);
    padding-block: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .job--current {
    padding: var(--space-8);
    margin-block: var(--space-8);
    background: var(--color-surface);
    border-bottom: none;
    border-left: 6px solid var(--color-accent);
  }

  .job-index {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-cyan);
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .job-role {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 0.95;
    color: var(--color-text);
    margin: 0 0 var(--space-2) 0;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  .job-company {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
    margin: 0;
  }

  .job-period {
    white-space: nowrap;
  }

  .job-period::before {
    content: "> " / "";
    color: var(--color-text-subtle);
  }

  .job--current .job-period::before {
    content: "> " / "";
    color: var(--color-accent);
  }

  .job--current .job-period {
    color: var(--color-accent-green);
  }

  .job-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.7;
    margin-bottom: var(--space-5);
    max-width: 65ch;
  }

  .job-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    max-width: 65ch;
  }

  .job-bullets li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .job-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.8em;
    width: var(--space-3);
    height: 1px;
    background: var(--color-border);
  }

  .job-metric {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-text);
    white-space: nowrap;
  }

  .job-bullets .job-bullet--lead {
    color: var(--color-text);
  }

  .job--current .job-bullet--lead::before {
    background: var(--color-accent);
  }

  .job-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }


  @media (max-width: 640px) {
    .job {
      grid-template-columns: 1fr;
      row-gap: var(--space-3);
    }

    .job--current {
      padding: var(--space-5);
    }

    .job-index {
      font-size: var(--text-3xl);
    }
  }
</style>
