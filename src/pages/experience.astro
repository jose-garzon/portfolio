---
import Layout from '../layouts/Layout.astro';
import ContactClose from '../modules/home/components/ContactClose.astro';
import Badge from '../shared/components/Badge.astro';
import PageHead from '../shared/components/PageHead.astro';
import { experience } from '../shared/data/experience';
import { fullName } from '../shared/data/personal';
import '../shared/styles/ledger.css';

const metricPattern = /(\d+%|in half)/;
const splitMetrics = (text: string) => text.split(metricPattern);

const seen = new Set<string>();
const stacks = experience.map((job) =>
  job.stack.filter((tech) => !seen.has(tech) && seen.add(tech)),
);

const splitPeriod = (period: string) => period.split(/\s*–\s*/);
const firstYear = Math.min(
  ...experience.map((job) => Number(job.period.match(/\d{4}/)?.[0] ?? Infinity)),
);
const years = new Date().getFullYear() - firstYear;
const companies = new Set(experience.map((job) => job.company.split('·').pop()?.trim())).size;
---

<Layout
  title={`Experience · ${fullName}`}
  description="Where I've shipped. Five years of production work at Aeroméxico, Disney, Growie, and Serempre."
>
  <main id="main" class="ledger-main experience-main">
    <div class="container">
      <PageHead
        title="Work history"
        lede="Software engineer with five years of production work: multi-team platform architecture, Backends for Frontends, and API contracts negotiated across teams."
        readouts={[
          { label: 'years', value: `${years}+` },
          { label: 'roles', value: experience.length },
          { label: 'clients', value: companies },
        ]}
      />

      <ol class="ledger timeline" reversed>
        {experience.map((job, i) => {
          const [from, to] = splitPeriod(job.period);
          const current = i === 0;
          return (
            <li class:list={['entry', 'job', { 'job--current': current }]}>
              <div class="entry-rail job-rail">
                <span class="entry-rail-key">{to}</span>
                <span>since {from}</span>
              </div>
              <article class="entry-body">
                <h2 class="entry-title">{job.role}</h2>
                <p class="entry-sub">{job.company}</p>
                <p class="entry-text">{job.description}</p>
                <ul class="job-bullets">
                  {job.bullets.map((bullet) => (
                    <li>
                      {splitMetrics(bullet).map((part, k) =>
                        k % 2 ? <strong class="job-metric">{part}</strong> : part
                      )}
                    </li>
                  ))}
                </ul>
                <ul class="entry-foot" aria-label="Stack">
                  {stacks[i].map((tech) => (
                    <li><Badge>{tech}</Badge></li>
                  ))}
                </ul>
              </article>
            </li>
          );
        })}
      </ol>
    </div>

    <ContactClose />
  </main>
</Layout>

<style>
  .experience-main {
    padding-bottom: 0;
  }

  .timeline {
    margin-bottom: var(--space-section);
  }

  .job-rail {
    position: relative;
    padding-left: var(--space-6);
  }

  .job-rail::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 9px;
    height: 9px;
    border: 1px solid var(--color-text-subtle);
    background: var(--color-bg);
  }

  .job::before {
    content: "";
    position: absolute;
    left: calc(var(--space-4) + 4px);
    top: 0;
    bottom: -1px;
    width: 1px;
    background: var(--color-border);
  }

  .job:first-child::before {
    top: calc(var(--space-10) + 0.8em);
  }

  .job:last-child::before {
    bottom: auto;
    height: calc(var(--space-10) + 0.8em);
  }

  .job--current .job-rail::before {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .job--current .entry-rail-key {
    color: var(--color-accent-green);
  }

  .job--current .entry-title {
    font-size: var(--text-4xl);
    line-height: 1.05;
  }

  .job-bullets {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 62ch;
    list-style: none;
  }

  .job-bullets li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .job-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.8em;
    width: var(--space-3);
    height: 1px;
    background: var(--color-text-subtle);
  }

  .job-metric {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-text);
    background: var(--color-accent-dim);
    padding-inline: 0.25em;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .job,
    .job:first-child,
    .job:last-child {
      padding-left: calc(var(--space-4) + var(--space-6));
    }

    .job::before,
    .job:first-child::before,
    .job:last-child::before {
      top: 0;
      bottom: -1px;
      height: auto;
    }

    .job:first-child::before {
      top: calc(var(--space-8) + 0.6em);
    }

    .job-rail {
      position: static;
      padding-left: 0;
    }

    .job-rail::before {
      left: var(--space-4);
      top: calc(var(--space-8) + 0.35em);
    }
  }
</style>
