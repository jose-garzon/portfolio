---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { fullName } from '../shared/data/personal';

const entry = await getEntry('now', 'index');

if (!entry) {
  return Astro.redirect('/');
}

const { Content } = await render(entry);
const updatedIso = entry.data.updated.toISOString().slice(0, 10);
---

<Layout
  title={`Now · ${fullName}`}
  description={`What ${fullName} is building, learning and reading right now.`}
>
  <main id="main" class="now-main">
    <div class="container">
      <header class="now-header">
        <p class="section-label">now</p>
        <h1 class="now-title"><span data-text="What I'm doing now">What I'm doing now</span></h1>
        <p class="now-sync data-tag">
          Last sync <time datetime={updatedIso}>{updatedIso}</time>
        </p>
      </header>

      <article class="prose">
        <Content />
      </article>
    </div>
  </main>
</Layout>

<style>
  .now-main {
    padding-top: calc(var(--nav-height) + var(--space-10));
    padding-bottom: var(--space-section);
  }

  .now-header {
    max-width: var(--max-prose);
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .now-title {
    font-size: var(--text-5xl);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-text);
    line-height: 0.92;
    letter-spacing: 0.01em;
    margin-bottom: var(--space-5);
  }

  .now-title::after {
    content: "";
    display: block;
    width: 3.5rem;
    height: 6px;
    margin-top: var(--space-5);
    background: var(--color-accent);
    box-shadow: 1.25rem 6px 0 var(--color-cyan);
  }

  .now-sync {
    margin-top: var(--space-8);
  }

  .now-sync time {
    font-family: var(--font-mono);
    color: var(--color-text);
    margin-left: var(--space-2);
  }
</style>

<style is:global>
  .now-main .prose {
    max-width: var(--max-prose);
    line-height: 1.65;
    color: var(--color-text);
    font-size: var(--text-lg);
  }

  .now-main .prose h2 {
    font-family: var(--font-condensed);
    color: var(--color-text);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: var(--space-12);
    margin-bottom: var(--space-5);
  }

  .now-main .prose h3 {
    font-family: var(--font-condensed);
    color: var(--color-text);
    font-size: var(--text-xl);
    font-weight: 600;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .now-main .prose p {
    margin-bottom: var(--space-5);
  }

  .now-main .prose ul,
  .now-main .prose ol {
    padding-left: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .now-main .prose ul { list-style: disc; }
  .now-main .prose ol { list-style: decimal; }

  .now-main .prose li {
    margin-bottom: var(--space-3);
  }

  .now-main .prose li::marker {
    color: var(--color-text-subtle);
  }

  .now-main .prose strong {
    font-weight: 600;
  }

  .now-main .prose a {
    color: var(--color-cyan);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-cyan) 45%, transparent);
    text-underline-offset: 3px;
  }

  .now-main .prose a:hover {
    text-decoration-color: var(--color-cyan);
  }
</style>
