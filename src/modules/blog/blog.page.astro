---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { fullName } from '../../shared/data/personal';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const tagSet = new Set<string>();
for (const post of posts) {
  for (const tag of post.data.tags) tagSet.add(tag);
}
const allTags = Array.from(tagSet).sort();

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Layout
  title={`Writing · ${fullName}`}
  description="Engineering notes on backend, Python, and systems design. Learning in public."
>
  <main id="main" class="blog-main">
    <div class="container">
      <header class="blog-header">
        <h1 class="blog-title">
          <span data-text="Notes on the work">Notes on the work</span>
        </h1>
        <p class="blog-subtext">
          Engineering notes on backend, Python, systems, and what I'm figuring out. Honest
          records, not polished tutorials.
        </p>
        <div class="blog-meta-row">
          <span class="blog-count">
            <span class="blog-count-value">{posts.length}</span>
            <span class="blog-count-label">
              post{posts.length === 1 ? '' : 's'} so far
            </span>
          </span>
        </div>
      </header>

      <div class="blog-body">
        <div class="blog-feed-col">
          {allTags.length > 0 && (
            <div class="tag-bar" role="group" aria-label="Filter by tag">
              <span class="tag-bar-label">filter</span>
              <ul class="tag-chips">
                <li>
                  <button
                    type="button"
                    class="tag-chip is-active"
                    data-tag-filter="all"
                    aria-pressed="true"
                  >
                    all
                  </button>
                </li>
                {allTags.map((tag) => (
                  <li>
                    <button
                      type="button"
                      class="tag-chip"
                      data-tag-filter={tag}
                      aria-pressed="false"
                    >
                      #{tag}
                    </button>
                  </li>
                ))}
              </ul>
              <p class="filter-status" aria-live="polite" data-filter-status>
                showing {posts.length} of {posts.length}
              </p>
            </div>
          )}

          {posts.length === 0 ? (
            <p class="empty">Nothing logged yet. First entry is in progress.</p>
          ) : (
            <ol class="feed">
              {posts.map((post, i) => (
                <li
                  class="feed-row"
                  data-tags={post.data.tags.join(',')}
                >
                  <span class="feed-frame hud" aria-hidden="true"></span>
                  <span class="feed-index" aria-hidden="true">
                    {String(posts.length - i).padStart(2, '0')}
                  </span>
                  <div class="feed-meta">
                    <time
                      class="feed-date"
                      datetime={post.data.pubDate.toISOString()}
                    >
                      {formatDate(post.data.pubDate)}
                    </time>
                  </div>
                  <h2 class="feed-title">
                    <a href={`/blog/${post.id}`} class="feed-link">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="feed-excerpt">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <ul class="feed-tags" aria-label="Filter by this post's tags">
                      {post.data.tags.map((tag) => (
                        <li>
                          <button type="button" class="feed-tag" data-row-tag={tag}>
                            #{tag}
                          </button>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          )}
          <p class="empty no-matches" hidden>
            No posts match this filter.
            <button type="button" class="clear-filter" data-clear-filter>
              clear filter
            </button>
          </p>
        </div>

      </div>
    </div>
  </main>
</Layout>

<style>
  .blog-main {
    padding-top: calc(var(--nav-height) + var(--space-12));
    padding-bottom: var(--space-section);
  }

  .blog-header {
    max-width: 720px;
    margin-bottom: var(--space-12);
  }

  .blog-title {
    font-size: var(--text-4xl);
    color: var(--color-text);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .blog-subtext {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 65ch;
    margin-bottom: var(--space-6);
  }

  .blog-meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .blog-count {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .blog-count-value {
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  .blog-body {
    display: block;
  }

  .tag-bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .tag-bar-label {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .tag-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .tag-chip {
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .tag-chip:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan-deep);
  }

  .filter-status {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    margin-left: auto;
  }

  .tag-chip.is-active {
    color: var(--color-bg);
    border-color: var(--color-cyan);
    background: var(--color-cyan);
  }

  .feed {
    margin-inline: calc(-1 * var(--space-4));
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .feed-row {
    position: relative;
    padding-inline: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-normal) var(--ease-out);
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'idx meta'
      'idx title'
      'idx excerpt'
      'idx tags';
    column-gap: var(--space-8);
    row-gap: var(--space-3);
    padding-block: var(--space-8);
    align-items: baseline;
  }

  .feed-frame {
    --hud-len: 12px;
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .feed-row:hover,
  .feed-row:focus-within {
    background: var(--color-surface);
  }

  .feed-row:hover .feed-frame,
  .feed-row:focus-within .feed-frame {
    opacity: 1;
  }

  .feed-row[hidden] {
    display: none;
  }

  .feed-link {
    color: inherit;
  }

  .feed-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .feed-link:focus-visible {
    outline: none;
  }

  .feed-link:focus-visible::after {
    outline: 2px solid var(--color-cyan);
    outline-offset: -2px;
  }

  .feed-index {
    grid-area: idx;
    align-self: start;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-accent);
    min-width: 2ch;
  }

  .feed-meta {
    grid-area: meta;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .feed-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .feed-title {
    grid-area: title;
    font-family: var(--font-condensed);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    transition: color var(--duration-fast) ease;
  }

  .feed-row:hover .feed-title {
    color: var(--color-cyan);
  }

  .feed-excerpt {
    grid-area: excerpt;
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 70ch;
  }

  .feed-tags {
    grid-area: tags;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    list-style: none;
  }

  .feed-tag {
    position: relative;
    z-index: 1;
    min-height: 44px;
    padding-inline: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    letter-spacing: 0.04em;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .feed-tag:hover {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .empty {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding-block: var(--space-8);
  }

  .clear-filter {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-cyan);
    background: transparent;
    border: 1px solid var(--color-cyan-deep);
    min-height: 44px;
    padding: var(--space-1) var(--space-3);
    margin-left: var(--space-3);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: background var(--duration-fast) ease;
  }

  .clear-filter:hover {
    background: var(--color-cyan-dim);
  }

  @media (max-width: 640px) {
    .feed-row {
      grid-template-areas:
        'idx meta'
        'title title'
        'excerpt excerpt'
        'tags tags';
      column-gap: var(--space-3);
      row-gap: var(--space-3);
      padding-block: var(--space-6);
    }

    .feed-index {
      align-self: center;
      font-size: var(--text-2xl);
      min-width: 0;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-tag-filter]');
  const rows = document.querySelectorAll<HTMLLIElement>('.feed-row');
  const noMatches = document.querySelector<HTMLParagraphElement>('.no-matches');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear-filter]');
  const rowTags = document.querySelectorAll<HTMLButtonElement>('[data-row-tag]');
  const status = document.querySelector<HTMLParagraphElement>('[data-filter-status]');

  const tagParam = 'tag';

  const syncUrl = (filter: string) => {
    const url = new URL(window.location.href);
    if (filter === 'all') url.searchParams.delete(tagParam);
    else url.searchParams.set(tagParam, filter);
    history.replaceState(null, '', url);
  };

  const applyFilter = (filter: string) => {
    let visibleCount = 0;
    rows.forEach((row) => {
      const tags = (row.dataset.tags ?? '').split(',').filter(Boolean);
      const match = filter === 'all' || tags.includes(filter);
      row.hidden = !match;
      if (match) visibleCount += 1;
    });
    if (noMatches) noMatches.hidden = visibleCount > 0;
    if (status) status.textContent = `showing ${visibleCount} of ${rows.length}`;
    chips.forEach((chip) => {
      const active = chip.dataset.tagFilter === filter;
      chip.classList.toggle('is-active', active);
      chip.setAttribute('aria-pressed', String(active));
    });
    syncUrl(filter);
  };

  const initial = new URLSearchParams(window.location.search).get(tagParam);
  if (initial && Array.from(chips).some((chip) => chip.dataset.tagFilter === initial)) {
    applyFilter(initial);
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const tag = chip.dataset.tagFilter;
      if (tag) applyFilter(tag);
    });
  });

  rowTags.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.rowTag;
      if (!tag) return;
      applyFilter(tag);
      document.querySelector<HTMLButtonElement>(`[data-tag-filter="${CSS.escape(tag)}"]`)?.focus();
    });
  });

  clearBtn?.addEventListener('click', () => {
    applyFilter('all');
    document.querySelector<HTMLButtonElement>('[data-tag-filter="all"]')?.focus();
  });
</script>
