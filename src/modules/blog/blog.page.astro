---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../shared/components/PageHead.astro';
import { fullName } from '../../shared/data/personal';
import '../../shared/styles/ledger.css';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const tagSet = new Set<string>();
for (const post of posts) {
  for (const tag of post.data.tags) tagSet.add(tag);
}
const allTags = Array.from(tagSet).sort();

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

const readMinutes = (body = '') =>
  Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 230));
---

<Layout
  title={`Writing · ${fullName}`}
  description="Engineering notes on Python, systems, and how computers work underneath. Learning in public."
>
  <main id="main" class="ledger-main">
    <div class="container">
      <PageHead
        title="Notes on the work"
        lede="Field notes from down the stack: Python, systems, memory, the places where things break. Honest records, not polished tutorials."
        readouts={[
          { label: 'posts', value: posts.length },
          { label: 'topics', value: allTags.length },
          ...(posts[0] ? [{ label: 'latest', value: formatDate(posts[0].data.pubDate) }] : []),
        ]}
      />

      {allTags.length > 0 && (
        <div class="tag-bar" role="group" aria-label="Filter by tag">
          <ul class="tag-chips">
            <li>
              <button type="button" class="tag-chip is-active" data-tag-filter="all" aria-pressed="true">
                all
              </button>
            </li>
            {allTags.map((tag) => (
              <li>
                <button type="button" class="tag-chip" data-tag-filter={tag} aria-pressed="false">
                  #{tag}
                </button>
              </li>
            ))}
          </ul>
          <p class="filter-status" aria-live="polite" data-filter-status>
            showing {posts.length} of {posts.length}
          </p>
        </div>
      )}

      {posts.length === 0 ? (
        <p class="empty">Nothing logged yet. First entry is in progress.</p>
      ) : (
        <ol class="ledger">
          {posts.map((post) => (
            <li class="entry" data-tags={post.data.tags.join(',')}>
              <div class="entry-rail">
                <time class="entry-rail-key" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                <span>{readMinutes(post.body)} min read</span>
              </div>
              <div class="entry-body">
                <h2 class="entry-title post-title">
                  <a href={`/blog/${post.id}`} class="entry-link">{post.data.title}</a>
                </h2>
                <p class="entry-text">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <ul class="entry-foot" aria-label="Filter by this post's tags">
                    {post.data.tags.map((tag) => (
                      <li>
                        <button type="button" class="feed-tag entry-raise" data-row-tag={tag}>
                          #{tag}
                        </button>
                      </li>
                    ))}
                    <li class="entry-go" aria-hidden="true">read →</li>
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      )}
      <p class="empty no-matches" hidden>
        No posts match this filter.
        <button type="button" class="clear-filter" data-clear-filter>clear filter</button>
      </p>
    </div>
  </main>
</Layout>

<style>
  .post-title {
    font-size: var(--text-4xl);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  @media (max-width: 640px) {
    .post-title {
      font-size: var(--text-3xl);
    }
  }

  .tag-bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .tag-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .tag-chip {
    min-height: 44px;
    padding: var(--space-1) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .tag-chip:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan-deep);
  }

  .tag-chip.is-active {
    color: var(--color-bg);
    border-color: var(--color-cyan);
    background: var(--color-cyan);
  }

  .filter-status {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .feed-tag {
    min-height: 44px;
    padding-inline: var(--space-2);
    margin-left: calc(-1 * var(--space-2));
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .feed-tag:hover {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .entry-go {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .empty {
    padding-block: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .clear-filter {
    min-height: 44px;
    padding: var(--space-1) var(--space-3);
    margin-left: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan-deep);
    transition: background var(--duration-fast) ease;
  }

  .clear-filter:hover {
    background: var(--color-cyan-dim);
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-tag-filter]');
  const rows = document.querySelectorAll<HTMLLIElement>('.entry');
  const noMatches = document.querySelector<HTMLParagraphElement>('.no-matches');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear-filter]');
  const rowTags = document.querySelectorAll<HTMLButtonElement>('[data-row-tag]');
  const status = document.querySelector<HTMLParagraphElement>('[data-filter-status]');

  const tagParam = 'tag';

  const syncUrl = (filter: string) => {
    const url = new URL(window.location.href);
    if (filter === 'all') url.searchParams.delete(tagParam);
    else url.searchParams.set(tagParam, filter);
    history.replaceState(null, '', url);
  };

  const applyFilter = (filter: string) => {
    let visibleCount = 0;
    rows.forEach((row) => {
      const tags = (row.dataset.tags ?? '').split(',').filter(Boolean);
      const match = filter === 'all' || tags.includes(filter);
      row.hidden = !match;
      if (match) visibleCount += 1;
    });
    if (noMatches) noMatches.hidden = visibleCount > 0;
    if (status) status.textContent = `showing ${visibleCount} of ${rows.length}`;
    chips.forEach((chip) => {
      const active = chip.dataset.tagFilter === filter;
      chip.classList.toggle('is-active', active);
      chip.setAttribute('aria-pressed', String(active));
    });
    syncUrl(filter);
  };

  const initial = new URLSearchParams(window.location.search).get(tagParam);
  if (initial && Array.from(chips).some((chip) => chip.dataset.tagFilter === initial)) {
    applyFilter(initial);
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const tag = chip.dataset.tagFilter;
      if (tag) applyFilter(tag);
    });
  });

  rowTags.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.rowTag;
      if (!tag) return;
      applyFilter(tag);
      document.querySelector<HTMLButtonElement>(`[data-tag-filter="${CSS.escape(tag)}"]`)?.focus();
    });
  });

  clearBtn?.addEventListener('click', () => {
    applyFilter('all');
    document.querySelector<HTMLButtonElement>('[data-tag-filter="all"]')?.focus();
  });
</script>
