---
import Layout from '../../../layouts/Layout.astro';
import Badge from '../../../shared/components/Badge.astro';
import { fullName } from '../../../shared/data/personal';

interface RelatedPost {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

interface AdjacentPost {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  prevPost?: AdjacentPost;
  nextPost?: AdjacentPost;
  relatedPosts?: RelatedPost[];
}

const { title, description, pubDate, tags, prevPost, nextPost, relatedPosts = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const formatShortDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Layout
  title={`${title} · ${fullName}`}
  description={description}
>
  <main class="post-main">
    <div class="container">
      <nav class="post-nav">
        <a href="/blog" class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M12 7H2M6 2L1 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to writing
        </a>
      </nav>

      <header class="post-header">
        <div class="post-meta-top">
          <time class="post-date" datetime={pubDate.toISOString()}>{formattedDate}</time>
        </div>
        <h1 class="post-title scanlines"><span data-text={title}>{title}</span></h1>
        <p class="post-description">{description}</p>
        {tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag) => <li><Badge pill>{tag}</Badge></li>)}
          </ul>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="post-footer">
        {(prevPost || nextPost) && (
          <nav class="post-pager" aria-label="Adjacent posts">
            {prevPost ? (
              <a href={`/blog/${prevPost.slug}`} class="pager-link pager-link--prev">
                <span class="pager-direction">← previous post</span>
                <span class="pager-title">{prevPost.title}</span>
              </a>
            ) : (
              <span></span>
            )}
            {nextPost ? (
              <a href={`/blog/${nextPost.slug}`} class="pager-link pager-link--next">
                <span class="pager-direction">next post →</span>
                <span class="pager-title">{nextPost.title}</span>
              </a>
            ) : (
              <span></span>
            )}
          </nav>
        )}

        {relatedPosts.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <p id="related-heading" class="related-kicker">
              <span class="related-kicker-prefix" aria-hidden="true">//</span>
              related
            </p>
            <ul class="related-list">
              {relatedPosts.map((rel) => (
                <li>
                  <a href={`/blog/${rel.slug}`} class="related-link">
                    <time class="related-date" datetime={rel.pubDate.toISOString()}>
                      {formatShortDate(rel.pubDate)}
                    </time>
                    <span class="related-title">{rel.title}</span>
                    <span class="related-excerpt">{rel.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <div class="post-tail">
          <a href="/blog" class="tail-link">← back to writing</a>
        </div>
      </footer>
    </div>
  </main>
</Layout>

<style>
  .post-main {
    padding-top: calc(var(--nav-height) + var(--space-10));
    padding-bottom: var(--space-section);
  }

  .post-nav {
    margin-bottom: var(--space-10);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .back-link:hover {
    color: var(--color-text-muted);
    border-color: var(--color-text-subtle);
    background: var(--color-surface);
  }

  .post-header {
    max-width: var(--max-prose);
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .post-meta-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .post-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
  }

  .post-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .post-footer {
    max-width: var(--max-prose);
    margin-top: var(--space-section);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .post-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-12);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
  }

  .pager-link:hover {
    border-color: var(--color-accent-dim);
    background: var(--color-surface-raised);
  }

  .pager-link--next {
    text-align: right;
    align-items: flex-end;
  }

  .pager-direction {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    letter-spacing: 0.04em;
  }

  .pager-title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .related {
    margin-bottom: var(--space-12);
  }

  .related-kicker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: var(--space-5);
  }

  .related-kicker-prefix {
    color: var(--color-accent);
  }

  .related-list {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .related-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .related-link {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    grid-template-areas:
      'date title'
      'date excerpt';
    column-gap: var(--space-5);
    row-gap: var(--space-1);
    padding: var(--space-4) 0;
    color: inherit;
    transition: background var(--duration-fast) ease;
  }

  .related-link:hover {
    background: var(--color-surface);
  }

  .related-date {
    grid-area: date;
    align-self: start;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    padding-top: 0.2em;
    min-width: 8ch;
  }

  .related-title {
    grid-area: title;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
    transition: color var(--duration-fast) ease;
  }

  .related-link:hover .related-title {
    color: var(--color-accent);
  }

  .related-excerpt {
    grid-area: excerpt;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .post-tail {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .tail-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease;
  }

  .tail-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .post-pager {
      grid-template-columns: 1fr;
    }

    .pager-link--next {
      text-align: left;
      align-items: flex-start;
    }

    .related-link {
      grid-template-columns: 1fr;
      grid-template-areas:
        'date'
        'title'
        'excerpt';
    }
  }
</style>

<style is:global>
  .prose {
    max-width: var(--max-prose);
    line-height: 1.9;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: var(--space-12);
    margin-bottom: var(--space-5);
    line-height: 1.25;
  }

  .prose h1 { font-size: var(--text-3xl); }
  .prose h2 { font-size: var(--text-2xl); }
  .prose h3 { font-size: var(--text-xl); }

  .prose h2 {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .prose p {
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
  }

  .prose strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-dim);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s ease;
  }

  .prose a:hover {
    text-decoration-color: var(--color-accent);
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    padding: 0.15em 0.45em;
    border-radius: var(--radius-sm);
  }

  .prose pre {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    overflow-x: auto;
    margin-bottom: var(--space-8);
    position: relative;
  }

  .prose pre code {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .prose ul,
  .prose ol {
    padding-left: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .prose ul { list-style: disc; }
  .prose ol { list-style: decimal; }

  .prose li {
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
  }

  .prose blockquote {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-6);
    margin-left: 0;
    margin-block: var(--space-8);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .prose blockquote p {
    margin-bottom: 0;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: var(--space-10);
  }

  .prose img {
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    margin-block: var(--space-8);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-8);
    font-size: var(--text-sm);
  }

  .prose th,
  .prose td {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .prose th {
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
  }
</style>
