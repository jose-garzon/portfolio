---
import Layout from '../../../layouts/Layout.astro';
import AuthorPanel from '../../../shared/components/AuthorPanel.astro';
import Badge from '../../../shared/components/Badge.astro';
import TocRail from '../../../shared/components/TocRail.astro';
import { fullName } from '../../../shared/data/personal';
import '../../../shared/styles/prose.css';

interface RelatedPost {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

interface AdjacentPost {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  prevPost?: AdjacentPost;
  nextPost?: AdjacentPost;
  relatedPosts?: RelatedPost[];
  sections?: { slug: string; text: string }[];
  readingMinutes: number;
}

const {
  title,
  description,
  pubDate,
  tags,
  prevPost,
  nextPost,
  relatedPosts = [],
  sections = [],
  readingMinutes,
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const formatShortDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Layout
  title={`${title} · ${fullName}`}
  description={description}
  type="article"
  publishedTime={pubDate}
>
  <main id="main" class="post-main">
    <div class="container">
      <nav class="post-nav" aria-label="Breadcrumb">
        <a href="/blog" class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M12 7H2M6 2L1 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to writing
        </a>
      </nav>

      <header class="post-header">
        <div class="post-meta-top">
          <time class="post-date" datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span class="post-meta-sep" aria-hidden="true">//</span>
          <span class="post-date">{readingMinutes} min read</span>
        </div>
        <h1 class="post-title"><span data-text={title}>{title}</span></h1>
        <p class="post-description">{description}</p>
        {tags.length > 0 && (
          <ul class="tag-list" aria-label="Tags">
            {tags.map((tag) => (
              <li>
                <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="tag-link">
                  <Badge pill>#{tag}</Badge>
                </a>
              </li>
            ))}
          </ul>
        )}
      </header>

      <div class="reading-body">
        <article class="prose">
          <slot />
        </article>

        <TocRail sections={sections} />
      </div>

      <footer class="post-footer">
        <AuthorPanel />

        {(prevPost || nextPost) && (
          <nav class="post-pager" aria-label="Adjacent posts">
            {prevPost ? (
              <a href={`/blog/${prevPost.slug}`} class="pager-link pager-link--prev">
                <span class="pager-direction">← previous post</span>
                <span class="pager-title">{prevPost.title}</span>
              </a>
            ) : (
              <span aria-hidden="true"></span>
            )}
            {nextPost ? (
              <a href={`/blog/${nextPost.slug}`} class="pager-link pager-link--next">
                <span class="pager-direction">next post →</span>
                <span class="pager-title">{nextPost.title}</span>
              </a>
            ) : (
              <span aria-hidden="true"></span>
            )}
          </nav>
        )}

        {relatedPosts.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <h2 id="related-heading" class="related-heading">Related</h2>
            <ul class="related-list">
              {relatedPosts.map((rel) => (
                <li>
                  <a href={`/blog/${rel.slug}`} class="related-link">
                    <time class="related-date" datetime={rel.pubDate.toISOString()}>
                      {formatShortDate(rel.pubDate)}
                    </time>
                    <span class="related-title">{rel.title}</span>
                    <span class="related-excerpt">{rel.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </footer>
    </div>
  </main>
</Layout>

<script>
  import '../../../shared/scripts/prose-enhance';
</script>

<style>
  .post-main {
    padding-top: calc(var(--nav-height) + var(--space-10));
    padding-bottom: var(--space-section);
  }

  .post-nav {
    margin-bottom: var(--space-8);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .back-link:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan);
    background: var(--color-surface);
  }

  .post-header {
    max-width: var(--read-measure);
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .post-meta-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .post-meta-sep {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  .post-title {
    text-wrap: balance;
    font-size: var(--text-4xl);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-text);
    line-height: 0.92;
    letter-spacing: 0.01em;
    margin-bottom: var(--space-5);
  }

  .post-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .tag-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text-subtle);
    transition: color var(--duration-fast) ease;
  }

  .tag-link:hover {
    color: var(--color-cyan);
  }

  .tag-link:hover :global(.badge) {
    border-color: var(--color-cyan);
  }



  .post-footer {
    max-width: var(--read-measure);
    margin-top: var(--space-section);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .post-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-12);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
  }

  .pager-link:hover {
    border-color: var(--color-accent-dim);
    background: var(--color-surface-raised);
  }

  .pager-link--next {
    text-align: right;
    align-items: flex-end;
  }

  .pager-direction {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    letter-spacing: 0.04em;
  }

  .pager-title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .related {
    margin-bottom: var(--space-12);
  }

  .related-heading {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-5);
  }

  .related-list {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .related-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .related-link {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    grid-template-areas:
      'date title'
      'date excerpt';
    column-gap: var(--space-5);
    row-gap: var(--space-1);
    padding: var(--space-4) 0;
    color: inherit;
    transition: background var(--duration-fast) ease;
  }

  .related-link:hover {
    background: var(--color-surface);
  }

  .related-date {
    grid-area: date;
    align-self: start;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    padding-top: 0.2em;
    min-width: 8ch;
  }

  .related-title {
    grid-area: title;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
    transition: color var(--duration-fast) ease;
  }

  .related-link:hover .related-title {
    color: var(--color-accent);
  }

  .related-excerpt {
    grid-area: excerpt;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .post-pager {
      grid-template-columns: 1fr;
    }

    .pager-link--next {
      text-align: left;
      align-items: flex-start;
    }

    .related-link {
      grid-template-columns: 1fr;
      grid-template-areas:
        'date'
        'title'
        'excerpt';
    }
  }
</style>
