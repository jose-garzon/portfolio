---
import { slugify } from '../progress';
import VimEditor from './VimEditor.tsx';

interface Props {
  title: string;
  code: string;
  goal?: string;
  target?: string;
}

const { title, code, goal, target } = Astro.props;
const level = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? '';
const id = slugify(title);
const goalId = goal ? `${id}-goal` : undefined;
---

<section class="exercise" id={id} aria-labelledby={`${id}-title`}>
  <h3 class="exercise-title" id={`${id}-title`}>{title}</h3>

  <div class="exercise-steps">
    <slot />
  </div>

  <VimEditor
    client:visible
    doc={code}
    label={title}
    level={level}
    exercise={id}
    goalId={goalId}
    target={target}
  />

  {goal && (
    <p class="exercise-goal" id={goalId}>
      <span class="exercise-goal-label">goal</span>
      {goal}
    </p>
  )}
</section>

<style>
  .exercise {
    margin-block: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .exercise-title {
    font-family: var(--font-condensed);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
    line-height: 1.25;
    scroll-margin-top: calc(var(--nav-height) + var(--space-6));
  }

  .exercise-steps {
    margin-bottom: var(--space-5);
    color: var(--color-text);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .exercise-steps :global(ol),
  .exercise-steps :global(ul) {
    padding-left: var(--space-6);
    margin: 0;
  }

  .exercise-steps :global(ol) {
    list-style: decimal;
  }

  .exercise-steps :global(li) {
    margin-bottom: var(--space-2);
  }

  .exercise-steps :global(li::marker) {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
  }

  .exercise-steps :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    padding: 0.1em 0.4em;
  }

  .exercise-goal {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .exercise-goal-label {
    flex-shrink: 0;
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-green);
  }
</style>
