---
import Layout from '../../../layouts/Layout.astro';
import { fullName } from '../../../shared/data/personal';
import { levels } from '../levels';
import '../vim.css';

interface Adjacent {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  summary: string;
  level: number;
  counts: Record<string, number>;
  prev?: Adjacent;
  next?: Adjacent;
}

const { title, summary, level, counts, prev, next } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const lastLevel = pad(levels[levels.length - 1].level);
---

<Layout title={`Vim · ${title} · ${fullName}`} description={summary}>
  <main id="main" class="vim-main vim-page">
    <div class="container">
      <div class="vim-shell">
        <div class="vim-content">
          <a href="/vim" class="back-link cut">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M12 7H2M6 2L1 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            All levels
          </a>

          <header class="vim-header">
            <p class="section-label">level {pad(level)} / {lastLevel}</p>
            <h1 class="vim-title"><span data-text={title}>{title}</span></h1>
            <p class="vim-summary">{summary}</p>
          </header>

          <details class="level-strip">
            <summary class="level-strip-summary">
              <span>Levels</span>
              <span class="level-strip-current">{pad(level)} / {lastLevel}</span>
            </summary>
            <ol class="level-strip-list">
              {levels.map((lvl) => (
                <li>
                  <a
                    href={`/vim/${lvl.slug}`}
                    class="sidebar-link"
                    aria-current={lvl.level === level ? 'page' : undefined}
                  >
                    <span class="sidebar-index">{pad(lvl.level)}</span>
                    <span class="sidebar-title">{lvl.title}</span>
                    <span class="vim-progress" data-progress-for={lvl.slug} data-total={counts[lvl.slug]}></span>
                  </a>
                </li>
              ))}
            </ol>
          </details>

          <div class="vim-prose">
            <slot />
          </div>

          <footer class="vim-footer">
            <nav class="vim-pager" aria-label="Adjacent levels">
              {prev && (
                <a href={`/vim/${prev.slug}`} class="pager-link pager-link--prev cut" rel="prev" aria-keyshortcuts="[">
                  <span class="pager-direction">← previous level</span>
                  <span class="pager-title">{prev.title}</span>
                </a>
              )}
              {next ? (
                <a href={`/vim/${next.slug}`} class="pager-link pager-link--next cut" rel="next" aria-keyshortcuts="]">
                  <span class="pager-direction">next level →</span>
                  <span class="pager-title">{next.title}</span>
                </a>
              ) : (
                <a href="/vim" class="pager-link pager-link--next pager-link--finish cut">
                  <span class="pager-direction">last level</span>
                  <span class="pager-title">You've covered the core. Review your progress →</span>
                </a>
              )}
            </nav>
            <p class="pager-keys">
              <kbd>[</kbd> and <kbd>]</kbd> switch levels when you're outside an editor.
            </p>
          </footer>
        </div>

        <nav class="vim-sidebar" aria-label="Levels">
          <p class="section-label">levels</p>
          <ol class="sidebar-list">
            {levels.map((lvl) => (
              <li>
                <a
                  href={`/vim/${lvl.slug}`}
                  class="sidebar-link"
                  aria-current={lvl.level === level ? 'page' : undefined}
                >
                  <span class="sidebar-index">{pad(lvl.level)}</span>
                  <span class="sidebar-title">{lvl.title}</span>
                  <span class="vim-progress" data-progress-for={lvl.slug} data-total={counts[lvl.slug]}></span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </div>
  </main>
</Layout>

<script>
  import '../progress-ui';

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || (e.key !== '[' && e.key !== ']')) return;
    const target = e.target as HTMLElement;
    if (target.closest('input, textarea, select, [contenteditable="true"], .cm-editor')) return;
    const link = document.querySelector<HTMLAnchorElement>(e.key === '[' ? '.vim-pager a[rel="prev"]' : '.vim-pager a[rel="next"]');
    if (link) window.location.href = link.href;
  });
</script>

<style>
  .vim-main {
    padding-top: calc(var(--nav-height) + var(--space-10));
    padding-bottom: var(--space-section);
  }

  .vim-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: var(--space-12);
    align-items: start;
  }

  .vim-content {
    min-width: 0;
  }

  .back-link {
    --cut: 8px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-bottom: var(--space-10);
    padding: 0 var(--space-4);
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    background: var(--color-surface);
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .back-link:hover {
    color: var(--color-bg);
    background: var(--color-cyan);
  }

  .vim-header {
    max-width: var(--max-prose);
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .vim-title {
    text-transform: uppercase;
    font-size: var(--text-5xl);
    color: var(--color-text);
    line-height: 0.92;
    letter-spacing: 0.01em;
    margin-bottom: var(--space-5);
    text-wrap: balance;
  }

  .vim-summary {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .vim-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-8));
    max-height: calc(100vh - var(--nav-height) - var(--space-12));
    overflow-y: auto;
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-5);
  }

  .sidebar-list,
  .level-strip-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .sidebar-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    margin-left: calc(var(--space-3) * -1);
    color: var(--color-text-subtle);
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .sidebar-link:hover {
    color: var(--color-cyan);
    background: var(--color-surface);
  }

  .sidebar-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .sidebar-title {
    font-size: var(--text-sm);
    line-height: 1.3;
  }

  .sidebar-link[aria-current='page'] {
    color: var(--color-text);
    background: var(--color-surface);
    box-shadow: inset 2px 0 0 var(--color-accent);
  }

  .sidebar-link[aria-current='page'] .sidebar-index {
    color: var(--color-accent);
  }

  .level-strip {
    display: none;
    margin-bottom: var(--space-10);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .level-strip-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-cyan);
    cursor: pointer;
  }

  .level-strip-current {
    color: var(--color-text-muted);
  }

  .level-strip-list {
    padding: var(--space-2) var(--space-4) var(--space-4) var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 1024px) {
    .vim-shell {
      grid-template-columns: 1fr;
    }

    .vim-sidebar {
      display: none;
    }

    .level-strip {
      display: block;
    }
  }

  .vim-footer {
    max-width: var(--max-prose);
    margin-top: var(--space-section);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .vim-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .pager-link {
    --cut: 12px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    transition: background var(--duration-normal) var(--ease-out);
  }

  .pager-link:hover {
    background: var(--color-surface-raised);
  }

  .pager-link:hover .pager-title {
    color: var(--color-cyan);
  }

  .pager-link--next {
    grid-column: 2;
    text-align: right;
    align-items: flex-end;
  }

  .pager-link--finish {
    background: var(--color-accent);
  }

  .pager-link--finish .pager-direction,
  .pager-link--finish .pager-title {
    color: var(--color-bg);
  }

  .pager-link--finish:hover {
    background: var(--color-cyan);
  }

  .pager-link--finish:hover .pager-title {
    color: var(--color-bg);
  }

  .pager-direction {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    letter-spacing: 0.06em;
  }

  .pager-title {
    font-family: var(--font-condensed);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
    transition: color var(--duration-fast) ease;
  }

  .pager-keys {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  @media (max-width: 640px) {
    .vim-pager {
      grid-template-columns: 1fr;
    }

    .pager-link--next {
      grid-column: auto;
      text-align: left;
      align-items: flex-start;
    }

    .pager-keys {
      display: none;
    }
  }
</style>
