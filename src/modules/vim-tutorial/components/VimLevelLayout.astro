---
import Layout from '../../../layouts/Layout.astro';
import { fullName } from '../../../shared/data/personal';
import { levels } from '../levels';

interface Adjacent {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  summary: string;
  level: number;
  prev?: Adjacent;
  next?: Adjacent;
}

const { title, summary, level, prev, next } = Astro.props;
const levelLabel = String(level).padStart(2, '0');
---

<Layout title={`Vim · ${title} — ${fullName}`} description={summary}>
  <main class="vim-main">
    <div class="container">
      <div class="vim-shell">
        <div class="vim-content">
      <nav class="vim-nav">
        <a href="/vim" class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M12 7H2M6 2L1 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          Back to Vim
        </a>
      </nav>

      <header class="vim-header">
        <p class="kicker">
          <span class="kicker-prefix" aria-hidden="true">//</span>
          level {levelLabel}
        </p>
        <h1 class="vim-title scanlines"><span data-text={title}>{title}</span></h1>
        <p class="vim-summary">{summary}</p>
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="vim-footer">
        <nav class="vim-pager" aria-label="Adjacent levels">
          {prev ? (
            <a href={`/vim/${prev.slug}`} class="pager-link pager-link--prev">
              <span class="pager-direction">← previous level</span>
              <span class="pager-title">{prev.title}</span>
            </a>
          ) : (
            <span></span>
          )}
          {next ? (
            <a href={`/vim/${next.slug}`} class="pager-link pager-link--next">
              <span class="pager-direction">next level →</span>
              <span class="pager-title">{next.title}</span>
            </a>
          ) : (
            <span></span>
          )}
        </nav>

        <div class="vim-tail">
          <a href="/vim" class="tail-link">← back to all levels</a>
        </div>
      </footer>
        </div>

        <aside class="vim-sidebar" aria-label="Levels">
          <nav class="sidebar-inner">
            <p class="sidebar-kicker">
              <span class="sidebar-kicker-prefix" aria-hidden="true">//</span>
              levels
            </p>
            <ol class="sidebar-list">
              {levels.map((lvl) => (
                <li>
                  <a
                    href={`/vim/${lvl.slug}`}
                    class="sidebar-link"
                    aria-current={lvl.level === level ? 'page' : undefined}
                  >
                    <span class="sidebar-index" aria-hidden="true">
                      {String(lvl.level).padStart(2, '0')}
                    </span>
                    <span class="sidebar-title">{lvl.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      </div>
    </div>
  </main>
</Layout>

<style>
  .vim-main {
    padding-top: calc(var(--nav-height) + var(--space-10));
    padding-bottom: var(--space-section);
  }

  .vim-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: var(--space-12);
    align-items: start;
  }

  .vim-content {
    min-width: 0;
  }

  .vim-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-8));
    max-height: calc(100vh - var(--nav-height) - var(--space-12));
    overflow-y: auto;
  }

  .sidebar-inner {
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-5);
  }

  .sidebar-kicker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: var(--space-4);
  }

  .sidebar-kicker-prefix {
    color: var(--color-accent);
  }

  .sidebar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sidebar-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    margin-left: calc(var(--space-3) * -1);
    border-radius: var(--radius-sm);
    color: var(--color-text-subtle);
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .sidebar-link:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .sidebar-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .sidebar-title {
    font-size: var(--text-sm);
    line-height: 1.3;
  }

  .sidebar-link[aria-current='page'] {
    color: var(--color-accent);
  }

  .sidebar-link[aria-current='page'] .sidebar-index {
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .vim-shell {
      grid-template-columns: 1fr;
    }

    .vim-sidebar {
      display: none;
    }
  }

  .vim-nav {
    margin-bottom: var(--space-10);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .back-link:hover {
    color: var(--color-text-muted);
    border-color: var(--color-text-subtle);
    background: var(--color-surface);
  }

  .vim-header {
    max-width: var(--max-prose);
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-4);
  }

  .kicker-prefix {
    color: var(--color-accent);
  }

  .vim-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
  }

  .vim-summary {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .vim-footer {
    max-width: var(--max-prose);
    margin-top: var(--space-section);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .vim-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-10);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
  }

  .pager-link:hover {
    border-color: var(--color-accent-dim);
    background: var(--color-surface-raised);
  }

  .pager-link--next {
    text-align: right;
    align-items: flex-end;
  }

  .pager-direction {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    letter-spacing: 0.04em;
  }

  .pager-title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .vim-tail {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .tail-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease;
  }

  .tail-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .vim-pager {
      grid-template-columns: 1fr;
    }

    .pager-link--next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>

<style is:global>
  .vim-main .prose {
    max-width: var(--max-prose);
    line-height: 1.8;
    color: var(--color-text);
    font-size: var(--text-base);
  }

  .vim-main .prose h2,
  .vim-main .prose h3 {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    line-height: 1.25;
  }

  .vim-main .prose h2 {
    font-size: var(--text-2xl);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .vim-main .prose h3 {
    font-size: var(--text-xl);
  }

  .vim-main .prose p {
    margin-bottom: var(--space-5);
  }

  .vim-main .prose strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .vim-main .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-dim);
    text-underline-offset: 3px;
  }

  .vim-main .prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    padding: 0.15em 0.45em;
    border-radius: var(--radius-sm);
  }

  .vim-main .prose pre {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    overflow-x: auto;
    margin-bottom: var(--space-6);
  }

  .vim-main .prose pre code {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .vim-main .prose ul,
  .vim-main .prose ol {
    padding-left: var(--space-6);
    margin-bottom: var(--space-5);
  }

  .vim-main .prose ul {
    list-style: disc;
  }

  .vim-main .prose ol {
    list-style: decimal;
  }

  .vim-main .prose li {
    margin-bottom: var(--space-2);
  }

  .vim-main .prose table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  .vim-main .prose th,
  .vim-main .prose td {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .vim-main .prose th {
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
  }

  .vim-main .prose hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: var(--space-8);
  }
</style>
