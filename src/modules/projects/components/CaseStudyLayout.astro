---
import Layout from '../../../layouts/Layout.astro';
import AuthorPanel from '../../../shared/components/AuthorPanel.astro';
import Badge from '../../../shared/components/Badge.astro';
import TocRail from '../../../shared/components/TocRail.astro';
import { fullName } from '../../../shared/data/personal';
import '../../../shared/styles/prose.css';

interface Props {
  name: string;
  role: string;
  period: string;
  status: 'shipping' | 'in-progress' | 'archived';
  summary: string;
  stack: string[];
  github?: string;
  live?: string;
  blogSlug?: string;
  highlights?: string[];
  sections?: { slug: string; text: string }[];
  prevProject?: { slug: string; name: string };
  nextProject?: { slug: string; name: string };
}

const {
  name,
  role,
  period,
  status,
  summary,
  stack,
  github,
  live,
  blogSlug,
  highlights = [],
  sections = [],
  prevProject,
  nextProject,
} = Astro.props;

const statusLabel = {
  shipping: 'shipping',
  'in-progress': 'in progress',
  archived: 'archived',
}[status];
---

<Layout
  title={`${name} · ${fullName}`}
  description={summary}
>
  <main id="main" class="case-main">
    <div class="container">
      <nav class="case-nav" aria-label="Breadcrumb">
        <a href="/#projects" class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path
              d="M12 7H2M6 2L1 7l5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Back to projects
        </a>
      </nav>

      <header class="case-header">
        <h1 class="case-title"><span data-text={name}>{name}</span></h1>
        <p class="case-summary">{summary}</p>

        <dl class="meta-grid">
          <div class="meta-cell">
            <dt>Role</dt>
            <dd>{role}</dd>
          </div>
          <div class="meta-cell">
            <dt>Period</dt>
            <dd>{period}</dd>
          </div>
          <div class="meta-cell">
            <dt>Status</dt>
            <dd>
              <span class={`status status--${status}`}>
                <span class="status-dot" aria-hidden="true"></span>
                {statusLabel}
              </span>
            </dd>
          </div>
          <div class="meta-cell meta-cell--wide">
            <dt>Stack</dt>
            <dd>
              <ul class="stack-chips">
                {stack.map((tech) => (
                  <li><Badge variant="accent">{tech}</Badge></li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>

        {(github || live || blogSlug) && (
          <ul class="case-links">
            {github && (
              <li>
                <a href={github} target="_blank" rel="noopener" class="case-link">
                  → source on github<span class="sr-only"> (opens in new tab)</span>
                </a>
              </li>
            )}
            {live && (
              <li>
                <a href={live} target="_blank" rel="noopener" class="case-link">
                  → live site<span class="sr-only"> (opens in new tab)</span>
                </a>
              </li>
            )}
            {blogSlug && (
              <li>
                <a href={`/blog/${blogSlug}`} class="case-link">
                  → related writing
                </a>
              </li>
            )}
          </ul>
        )}
      </header>

      {highlights.length > 0 && (
        <section class="highlights cut" aria-labelledby="highlights-heading">
          <h2 id="highlights-heading" class="data-tag highlights-label">// key decisions</h2>
          <ol class="highlights-list">
            {highlights.map((item) => <li>{item}</li>)}
          </ol>
        </section>
      )}

      <div class="reading-body">
        <article class="prose">
          <slot />
        </article>
        <TocRail sections={sections} />
      </div>

      <footer class="case-footer">
        <AuthorPanel label="built by" />

        {(prevProject || nextProject) && (
          <nav class="case-pager" aria-label="Adjacent case studies">
            {prevProject ? (
              <a href={`/projects/${prevProject.slug}`} class="pager-link pager-link--prev">
                <span class="pager-direction">← previous case study</span>
                <span class="pager-name">{prevProject.name}</span>
              </a>
            ) : (
              <span aria-hidden="true"></span>
            )}
            {nextProject ? (
              <a href={`/projects/${nextProject.slug}`} class="pager-link pager-link--next">
                <span class="pager-direction">next case study →</span>
                <span class="pager-name">{nextProject.name}</span>
              </a>
            ) : (
              <span aria-hidden="true"></span>
            )}
          </nav>
        )}

        <a href="/projects" class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path
              d="M12 7H2M6 2L1 7l5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          All projects
        </a>
      </footer>
    </div>
  </main>
</Layout>

<script>
  import '../../../shared/scripts/prose-enhance';
</script>

<style>
  .case-main {
    padding-top: calc(var(--nav-height) + var(--space-10));
    padding-bottom: var(--space-section);
  }

  .case-nav {
    margin-bottom: var(--space-10);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    min-height: 44px;
    color: var(--color-text-subtle);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .back-link:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan);
    background: var(--color-surface);
  }

  .case-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .case-title {
    text-wrap: balance;
    font-size: var(--text-5xl);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-text);
    line-height: 0.92;
    letter-spacing: 0.01em;
    margin-bottom: var(--space-5);
  }

  .case-summary {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: var(--read-measure);
    text-wrap: pretty;
    margin-bottom: var(--space-10);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(3, auto) 1fr;
    gap: var(--space-5) var(--space-10);
    align-items: start;
    margin: 0 0 var(--space-8) 0;
  }

  .meta-cell--wide {
    grid-column: 1 / -1;
  }

  .meta-cell dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-2);
  }

  .meta-cell dd {
    font-size: var(--text-sm);
    color: var(--color-text);
    margin: 0;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    border: 1px solid;
  }

  .status-dot {
    width: 6px;
    height: 6px;
  }

  .status--shipping {
    color: var(--color-accent-green);
    border-color: color-mix(in srgb, var(--color-accent-green) 30%, transparent);
    background: color-mix(in srgb, var(--color-accent-green) 6%, transparent);
  }

  .status--shipping .status-dot {
    background: var(--color-accent-green);
  }

  .status--in-progress {
    color: var(--color-hack-yellow);
    border-color: color-mix(in srgb, var(--color-hack-yellow) 30%, transparent);
    background: color-mix(in srgb, var(--color-hack-yellow) 6%, transparent);
  }

  .status--in-progress .status-dot {
    background: var(--color-hack-yellow);
  }

  .status--archived {
    color: var(--color-text-subtle);
    border-color: var(--color-border);
    background: var(--color-surface);
  }

  .status--archived .status-dot {
    background: var(--color-text-subtle);
  }

  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    list-style: none;
  }

  .case-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-cyan);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-cyan) 45%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--duration-fast) ease;
  }

  .case-link:hover {
    text-decoration-color: var(--color-cyan);
  }

  .highlights {
    position: relative;
    max-width: var(--read-wide);
    margin-bottom: var(--space-12);
    padding: var(--space-8);
    padding-left: calc(var(--space-8) + 6px);
    background: var(--color-surface);
  }

  .highlights::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 6px;
    background: var(--color-accent);
  }

  .highlights-label {
    margin-bottom: var(--space-5);
  }

  .highlights-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5) var(--space-8);
    list-style: none;
  }

  .highlights-list li {
    color: var(--color-text);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .highlights-list li::before {
    content: '>';
    margin-right: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  .case-footer {
    max-width: var(--read-measure);
    margin-top: var(--space-16);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .case-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  .case-pager:has(> :only-child),
  .case-pager:has(> span[aria-hidden]) {
    grid-template-columns: 1fr;
  }

  .case-pager > span[aria-hidden] {
    display: none;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
  }

  .pager-link:hover {
    border-color: var(--color-cyan);
    background: var(--color-surface-raised);
  }

  .pager-link--next {
    text-align: right;
    align-items: flex-end;
  }

  .pager-direction {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    letter-spacing: 0.04em;
  }

  .pager-name {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .meta-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5) var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .meta-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-pager {
      grid-template-columns: 1fr;
    }

    .pager-link--next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
