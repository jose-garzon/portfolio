---
interface Props {
  size?: string;
}

const { size = 'clamp(220px, 32vw, 360px)' } = Astro.props;

// Stencil JG on a 220x240 grid: thick butt-capped strokes with bridge gaps,
// echoing the Saira Stencil display name.
const strokes = [
  'M36 42 H98',
  'M90 42 V112',
  'M90 128 V198 H28 V158',
  'M200 92 V42 H130 V112',
  'M130 128 V198 H200 V132 H164',
];
---

<div class="monogram">
  {['echo', 'main'].map((layer) => (
    <svg
      class={`mono-svg mono-svg--${layer}`}
      viewBox="0 0 220 240"
      fill="none"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
    >
      {strokes.map((d) => (
        <path d={d} stroke="currentColor" stroke-width="16" stroke-linecap="butt" stroke-linejoin="miter" />
      ))}
      <path d="M30 222 H70 M150 222 H198" stroke="currentColor" stroke-width="3" />
    </svg>
  ))}

  {['tl', 'tr', 'bl', 'br'].map((corner) => (
    <span class={`mono-corner mono-corner--${corner}`} aria-hidden="true">
      <span class="mono-corner-h"></span>
      <span class="mono-corner-v"></span>
    </span>
  ))}
</div>

<style define:vars={{ monoSize: size }}>
  .monogram {
    position: relative;
    width: var(--monoSize);
    aspect-ratio: 220 / 240;
    margin-inline: auto;
  }

  .mono-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .mono-svg--main {
    color: var(--color-accent);
  }

  .mono-svg--echo {
    color: var(--color-cyan);
    transform: translateX(-4px);
    animation: mono-glitch-echo 3s steps(1) infinite;
  }

  .mono-svg--main {
    animation: mono-glitch-main 3s steps(1) infinite;
  }

  @keyframes mono-glitch-echo {
    0%, 88%, 100% { transform: translateX(-4px); clip-path: inset(0); }
    90% { transform: translateX(-12px); clip-path: inset(22% 0 52% 0); }
    93% { transform: translateX(6px); clip-path: inset(60% 0 18% 0); }
    96% { transform: translateX(-8px); clip-path: inset(8% 0 74% 0); }
  }

  @keyframes mono-glitch-main {
    0%, 88%, 100% { transform: none; }
    91% { transform: translateX(3px); }
    94% { transform: translateX(-2px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mono-svg--echo,
    .mono-svg--main {
      animation: none;
    }
  }

  .mono-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    color: var(--color-accent);
    z-index: 4;
  }

  .mono-corner-h,
  .mono-corner-v {
    position: absolute;
    background: currentColor;
  }

  .mono-corner-h {
    width: 100%;
    height: 1.5px;
  }

  .mono-corner-v {
    width: 1.5px;
    height: 100%;
  }

  .mono-corner--tl {
    left: -28px;
  }
  .mono-corner--tl .mono-corner-h {
    top: 0;
    left: 0;
  }
  .mono-corner--tl .mono-corner-v {
    top: 0;
    left: 0;
  }

  .mono-corner--tr {
    right: -28px;
  }
  .mono-corner--tr .mono-corner-h {
    top: 0;
    right: 0;
  }
  .mono-corner--tr .mono-corner-v {
    top: 0;
    right: 0;
  }

  .mono-corner--bl {
    bottom: 0;
    left: -28px;
  }
  .mono-corner--bl .mono-corner-h {
    bottom: 0;
    left: 0;
  }
  .mono-corner--bl .mono-corner-v {
    bottom: 0;
    left: 0;
  }

  .mono-corner--br {
    bottom: 0;
    right: -28px;
  }
  .mono-corner--br .mono-corner-h {
    bottom: 0;
    right: 0;
  }
  .mono-corner--br .mono-corner-v {
    bottom: 0;
    right: 0;
  }
</style>
