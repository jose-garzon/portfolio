---
import { getCollection } from 'astro:content';
import Monogram from './Monogram.astro';
import { personal } from '../../../shared/data/personal';
import { hero } from '../../../shared/data/hero';

const allPosts = await getCollection('blog');
const latestPost = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())[0];

const latestReadingTime = latestPost
  ? Math.max(1, Math.ceil((latestPost.body ?? '').trim().split(/\s+/).length / 200))
  : null;

const latestFormattedDate = latestPost
  ? latestPost.data.pubDate.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    })
  : null;
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero-ambient" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-monogram-wrap">
      <Monogram size="clamp(140px, 20vw, 220px)" />
    </div>

    <h1 id="hero-name" class="hero-name">
      <span class="hero-name-first">{personal.name.first.toLowerCase()}</span>
      <span class="hero-name-sep" aria-hidden="true">/</span>
      <span class="hero-name-last">{personal.name.last.toLowerCase()}</span>
    </h1>

    <p class="hero-role">{personal.title}</p>

    <p class="hero-tagline">{hero.tagline}</p>

    <div class="hero-actions">
      <a href={personal.links.email} class="hero-cta hero-cta--primary">
        <span>Contact</span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
      </a>
      <a href="/experience" class="hero-cta hero-cta--secondary">
        <span>Experience</span>
        <span class="hero-cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  {
    latestPost && (
      <div class="hero-latest-wrap">
        <a href={`/blog/${latestPost.id}`} class="hero-latest" aria-label={`Latest writing: ${latestPost.data.title}`}>
          <span class="hero-latest-kicker">
            <span class="hero-latest-prefix" aria-hidden="true">{`//`}</span>
            latest writing
          </span>
          <span class="hero-latest-title">{latestPost.data.title}</span>
          <span class="hero-latest-meta">
            <span class="hero-latest-date">{latestFormattedDate}</span>
            <span class="hero-latest-sep" aria-hidden="true">·</span>
            <span class="hero-latest-time">{latestReadingTime} min read</span>
          </span>
          <span class="hero-latest-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/blog" class="hero-latest-all">
          view all writing
          <span class="hero-latest-all-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    )
  }
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: clamp(var(--space-12), 8vh, var(--space-16)) var(--space-6);
  }

  .hero-ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 55% 45% at 50% 45%,
      rgba(255, 45, 85, 0.07) 0%,
      rgba(255, 45, 85, 0.02) 40%,
      transparent 75%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    max-width: 680px;
  }

  .hero-monogram-wrap {
    margin-bottom: var(--space-2);
    animation: hero-in 0.9s var(--ease-out) 0.1s both;
  }

  .hero-name {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.04em;
    text-transform: lowercase;
    margin: var(--space-3) 0 0 0;
    animation: hero-in 0.7s var(--ease-out) 0.3s both;
  }

  .hero-name-sep {
    color: var(--color-accent);
    font-weight: 400;
    font-family: var(--font-mono);
  }

  .hero-role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0;
    animation: hero-in 0.7s var(--ease-out) 0.4s both;
  }

  .hero-tagline {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: 52ch;
    margin: var(--space-2) 0 0 0;
    animation: hero-in 0.7s var(--ease-out) 0.5s both;
  }

  .hero-actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
    animation: hero-in 0.7s var(--ease-out) 0.6s both;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.75rem 1.25rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition:
      background var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-spring),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .hero-cta--primary {
    background: var(--color-accent);
    color: #ffffff;
    border: 1px solid var(--color-accent);
  }

  .hero-cta--primary:hover {
    background: var(--color-accent-warm);
    border-color: var(--color-accent-warm);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(255, 45, 85, 0.28);
  }

  .hero-cta--primary svg {
    transition: transform var(--duration-normal) var(--ease-spring);
  }

  .hero-cta--primary:hover svg {
    transform: translateX(2px);
  }

  .hero-cta--secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .hero-cta--secondary:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-dim);
    background: var(--color-accent-glow);
    transform: translateY(-2px);
  }

  .hero-cta-arrow {
    font-family: var(--font-mono);
    transition: transform var(--duration-normal) var(--ease-spring);
  }

  .hero-cta--secondary:hover .hero-cta-arrow {
    transform: translateX(3px);
    color: var(--color-accent);
  }

  .hero-latest-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    width: min(560px, 100%);
    margin-top: clamp(var(--space-8), 6vh, var(--space-12));
    padding: 0 var(--space-4);
    z-index: 1;
    animation: hero-in 0.7s var(--ease-out) 0.8s both;
  }

  .hero-latest {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto auto;
    grid-template-areas:
      'kicker meta arrow'
      'title title arrow';
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    width: 100%;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: rgba(10, 0, 5, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: inherit;
    text-decoration: none;
    box-shadow:
      -10px 0 32px rgba(255, 45, 85, 0.1),
      10px 0 32px rgba(45, 127, 255, 0.08);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-spring),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .hero-latest::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      var(--color-accent),
      transparent
    );
    opacity: 0.6;
  }

  .hero-latest:hover {
    border-color: var(--color-accent-dim);
    background: rgba(20, 5, 10, 0.8);
    transform: translateY(-2px);
    box-shadow:
      -14px 0 40px rgba(255, 45, 85, 0.18),
      14px 0 40px rgba(45, 127, 255, 0.12);
  }

  .hero-latest:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .hero-latest-kicker {
    grid-area: kicker;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero-latest-prefix {
    color: var(--color-accent);
    opacity: 0.7;
  }

  .hero-latest-meta {
    grid-area: meta;
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
    letter-spacing: 0.04em;
    flex-wrap: wrap;
  }

  .hero-latest-sep {
    color: var(--color-border);
  }

  .hero-latest-title {
    grid-area: title;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.35;
    text-align: left;
    transition: color var(--duration-fast) ease;
  }

  .hero-latest:hover .hero-latest-title {
    color: var(--color-accent);
  }

  .hero-latest-arrow {
    grid-area: arrow;
    align-self: center;
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    color: var(--color-text-subtle);
    transition:
      transform var(--duration-normal) var(--ease-spring),
      color var(--duration-fast) ease;
  }

  .hero-latest:hover .hero-latest-arrow {
    transform: translateX(4px);
    color: var(--color-accent);
  }

  .hero-latest-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .hero-latest-all:hover {
    color: var(--color-accent);
  }

  .hero-latest-all-arrow {
    transition: transform var(--duration-normal) var(--ease-spring);
  }

  .hero-latest-all:hover .hero-latest-all-arrow {
    transform: translate(2px, -2px);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 580px;
    }

    .hero-tagline {
      font-size: var(--text-sm);
    }

    .hero-cta {
      padding: 0.625rem 1rem;
    }

    .hero-latest {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'kicker arrow'
        'title arrow'
        'meta arrow';
      column-gap: var(--space-3);
      padding: var(--space-3) var(--space-4);
    }

    .hero-latest-meta {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-monogram-wrap,
    .hero-name,
    .hero-role,
    .hero-tagline,
    .hero-actions,
    .hero-latest-wrap {
      animation: none;
    }
  }
</style>
