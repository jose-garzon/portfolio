---
import { getCollection } from 'astro:content';
import { hero } from '../../../shared/data/hero';
import { personal } from '../../../shared/data/personal';
import Monogram from './Monogram.astro';

const allPosts = await getCollection('blog');
const latestPost = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())[0];

const latestDate = latestPost ? latestPost.data.pubDate.toISOString().slice(0, 10) : null;
const first = personal.name.first.toUpperCase();
const last = personal.name.last.toUpperCase();
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero-readout" aria-label="Status">
    {hero.stats.map((stat) => (
      <span class="hero-readout-item">
        <span class="hero-readout-key">{stat.label}</span>
        <span class="hero-readout-value">{stat.value}</span>
      </span>
    ))}
  </div>

  <div class="hero-stage">
    <h1 id="hero-name" class="hero-name">
      <span class="hero-name-line" data-text={first}>{first}</span>
      <span class="hero-name-line hero-name-line--last" data-text={last}>{last}</span>
    </h1>
    <span class="hero-corrupt hero-corrupt--a" aria-hidden="true"></span>
    <span class="hero-corrupt hero-corrupt--b" aria-hidden="true"></span>
    <p class="hero-role">{personal.title}</p>
  </div>

  <div class="hero-console">
    <div class="hero-panel hud">
      <p class="hero-panel-tag data-tag">whoami</p>
      <p class="hero-tagline">{hero.tagline}</p>

      <div class="hero-actions">
        <a href={personal.links.email} class="hero-cta hero-cta--primary cut">Contact</a>
        <a href="/experience" class="hero-cta hero-cta--secondary">
          Experience <span aria-hidden="true">→</span>
        </a>
        <a
          href={personal.links.github}
          class="hero-icon-link"
          target="_blank"
          rel="me noreferrer"
          aria-label="GitHub"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.13-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02 0 2.05.14 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.87.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.29 0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
            ></path>
          </svg>
        </a>
        <a
          href={personal.links.linkedin}
          class="hero-icon-link"
          target="_blank"
          rel="me noreferrer"
          aria-label="LinkedIn"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="hero-sigil" aria-hidden="true">
      <Monogram size="clamp(140px, 18vw, 240px)" />
    </div>
  </div>

  {
    latestPost && (
      <a href={`/blog/${latestPost.id}`} class="hero-latest">
        <span class="hero-latest-key data-tag">last transmission</span>
        <span class="hero-latest-date">{latestDate}</span>
        <span class="hero-latest-title">{latestPost.data.title}</span>
        <span class="hero-latest-arrow" aria-hidden="true">→</span>
      </a>
    )
  }
</section>

<style>
  .hero {
    position: relative;
    max-width: var(--max-content);
    margin-inline: auto;
    padding: calc(var(--nav-height) + var(--space-8)) var(--space-6) var(--space-section);
    overflow-x: clip;
  }

  .hero-readout {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hero-readout-item {
    display: inline-flex;
    gap: var(--space-2);
    color: var(--color-text-subtle);
  }

  .hero-readout-value {
    color: var(--color-text);
  }

  .hero-stage {
    position: relative;
    margin-top: var(--space-6);
  }

  .hero-name {
    display: flex;
    flex-direction: column;
    margin: 0 0 0 -0.05em;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(4.25rem, 17vw, 11.5rem);
    line-height: 0.82;
    letter-spacing: -0.01em;
    color: var(--color-text);
    white-space: nowrap;
  }

  .hero-name-line--last {
    padding-left: 0.5em;
    color: var(--color-accent);
  }

  .hero-name-line::before,
  .hero-name-line::after {
    opacity: 1;
  }

  .hero-name-line::before {
    color: var(--color-cyan);
    -webkit-text-fill-color: var(--color-cyan);
    animation: tear-a 560ms steps(1) 0.5s both;
  }

  .hero-name-line::after {
    color: var(--color-text);
    -webkit-text-fill-color: var(--color-text);
    animation: tear-b 560ms steps(1) 0.55s both;
  }

  .hero-name-line--last::before,
  .hero-name-line--last::after {
    padding-left: inherit;
  }

  .hero-name-line--last::after {
    color: var(--color-magenta);
    -webkit-text-fill-color: var(--color-magenta);
  }

  @keyframes tear-a {
    0% { clip-path: inset(0 0 100% 0); transform: translateX(0); }
    20% { clip-path: inset(10% 0 70% 0); transform: translateX(-0.14em); }
    45% { clip-path: inset(62% 0 18% 0); transform: translateX(0.08em); }
    70% { clip-path: inset(30% 0 52% 0); transform: translateX(-0.1em); }
    90% { clip-path: inset(38% 0 52% 0); transform: translateX(-0.07em); }
    100% { clip-path: inset(0 0 100% 0); transform: translateX(0); }
  }

  @keyframes tear-b {
    0% { clip-path: inset(0 0 100% 0); transform: translateX(0); }
    25% { clip-path: inset(55% 0 25% 0); transform: translateX(0.12em); }
    50% { clip-path: inset(5% 0 82% 0); transform: translateX(0.06em); }
    75% { clip-path: inset(72% 0 10% 0); transform: translateX(0.14em); }
    90% { clip-path: inset(66% 0 27% 0); transform: translateX(0.05em); }
    100% { clip-path: inset(0 0 100% 0); transform: translateX(0); }
  }

  .hero-name:hover .hero-name-line::before {
    animation: tear-hover-a 560ms steps(1) both;
  }

  .hero-name:hover .hero-name-line::after {
    animation: tear-hover-b 560ms steps(1) 50ms both;
  }

  @keyframes tear-hover-a {
    0% { clip-path: inset(0 0 100% 0); transform: translateX(0); }
    20% { clip-path: inset(10% 0 70% 0); transform: translateX(-0.14em); }
    45% { clip-path: inset(62% 0 18% 0); transform: translateX(0.08em); }
    70% { clip-path: inset(30% 0 52% 0); transform: translateX(-0.1em); }
    90% { clip-path: inset(38% 0 52% 0); transform: translateX(-0.07em); }
    100% { clip-path: inset(0 0 100% 0); transform: translateX(0); }
  }

  @keyframes tear-hover-b {
    0% { clip-path: inset(0 0 100% 0); transform: translateX(0); }
    25% { clip-path: inset(55% 0 25% 0); transform: translateX(0.12em); }
    50% { clip-path: inset(5% 0 82% 0); transform: translateX(0.06em); }
    75% { clip-path: inset(72% 0 10% 0); transform: translateX(0.14em); }
    90% { clip-path: inset(66% 0 27% 0); transform: translateX(0.05em); }
    100% { clip-path: inset(0 0 100% 0); transform: translateX(0); }
  }

  .hero-corrupt {
    position: absolute;
    pointer-events: none;
  }

  .hero-corrupt--a {
    top: clamp(3rem, 8vw, 7.8rem);
    right: 4%;
    width: clamp(3rem, 10vw, 8rem);
    height: 10px;
    background: var(--color-accent);
  }

  .hero-corrupt--b {
    top: calc(clamp(3rem, 8vw, 7.8rem) + 16px);
    right: calc(4% + 2.5rem);
    width: clamp(2rem, 6vw, 5rem);
    height: 3px;
    background: var(--color-cyan);
  }

  .hero-console {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-8);
    align-items: end;
    margin-top: var(--space-10);
  }

  .hero-panel {
    padding: var(--space-6);
    border: 1px solid var(--color-border-subtle);
  }

  .hero-panel-tag {
    color: var(--color-cyan);
    margin-bottom: var(--space-3);
  }

  .hero-panel-tag::before {
    content: "$ ";
    color: var(--color-accent);
  }

  .hero-role {
    margin-top: var(--space-6);
    max-width: 22ch;
    font-family: var(--font-condensed);
    font-weight: 600;
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--color-text);
  }

  .hero-tagline {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: var(--max-measure);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .hero-cta--primary {
    --cut: 10px;
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .hero-cta--primary:hover {
    background: var(--color-cyan);
  }

  .hero-cta--secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .hero-cta--secondary:hover {
    border-color: var(--color-cyan);
    color: var(--color-cyan);
  }

  .hero-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-text-subtle);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .hero-icon-link:hover {
    color: var(--color-cyan);
  }

  .hero-sigil {
    justify-self: end;
  }

  .hero-latest {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    color: inherit;
  }

  .hero-latest-key {
    color: var(--color-accent);
  }

  .hero-latest-date {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .hero-latest-title {
    font-family: var(--font-condensed);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-text);
    transition: color var(--duration-fast) ease;
  }

  .hero-latest-arrow {
    font-family: var(--font-mono);
    color: var(--color-text-subtle);
    transition: transform var(--duration-normal) var(--ease-out), color var(--duration-fast) ease;
  }

  .hero-latest:hover .hero-latest-title,
  .hero-latest:hover .hero-latest-arrow {
    color: var(--color-cyan);
  }

  .hero-latest:hover .hero-latest-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 860px) {
    .hero-console {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-sigil {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero-corrupt {
      display: none;
    }

    .hero-name {
      white-space: normal;
    }

    .hero-name-line--last {
      padding-left: 0;
    }

    .hero-latest {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .hero-latest-title {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-name-line::before,
    .hero-name-line::after {
      animation: none;
      clip-path: inset(0 0 100% 0);
    }
  }
</style>
