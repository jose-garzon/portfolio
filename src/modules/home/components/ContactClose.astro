---
import { personal } from '../../../shared/data/personal';
import CorruptionField from './CorruptionField.astro';

const address = personal.links.email.replace('mailto:', '');
---

<section class="section contact-close" aria-labelledby="contact-heading">
  <CorruptionField />
  <div class="container contact-inner hud">
    <h2 id="contact-heading" class="contact-heading">Got a system worth opening up? Let's talk.</h2>
    <p class="contact-copy">
      Open to software engineering roles close to the metal: systems, performance, the layers most people never open. Email is the fastest way to reach me.
    </p>
    <a href={personal.links.email} class="contact-email">{address}</a>
    <ul class="contact-links">
      <li>
        <a href={personal.links.github} target="_blank" rel="me noreferrer">github ↗</a>
      </li>
      <li>
        <a href={personal.links.linkedin} target="_blank" rel="me noreferrer">linkedin ↗</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact-close {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .contact-inner {
    --hud-color: rgba(0, 229, 255, 0.85);
    padding-block: var(--space-12);
    background-color: rgba(10, 10, 12, 0.45);
    border: 1px solid rgba(238, 242, 247, 0.08);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    box-shadow:
      inset 0 1px 0 rgba(238, 242, 247, 0.1),
      0 30px 80px -30px rgba(0, 0, 0, 0.95);
  }

  .contact-heading {
    font-size: var(--text-4xl);
    line-height: 0.95;
    text-transform: uppercase;
    max-width: 18ch;
    text-wrap: balance;
  }

  .contact-copy {
    margin-top: var(--space-4);
    max-width: var(--max-measure);
    color: var(--color-text-muted);
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-6);
    font-family: var(--font-condensed);
    font-weight: 600;
    font-size: clamp(1.375rem, 1rem + 1.8vw, 2.25rem);
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
    text-shadow: 0 0 18px rgba(255, 45, 85, 0.45);
    transition: color var(--duration-fast) var(--ease-out), text-shadow var(--duration-normal) var(--ease-out);
  }

  .contact-email:hover {
    color: var(--color-cyan);
    text-shadow: 0 0 18px rgba(0, 229, 255, 0.5);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-4);
    list-style: none;
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-cyan);
  }

  .contact-links a:hover {
    color: var(--color-text);
  }
</style>
