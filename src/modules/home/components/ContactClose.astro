---
import { personal } from '../../../shared/data/personal';

const address = personal.links.email.replace('mailto:', '');
---

<section class="section contact-close" aria-labelledby="contact-heading">
  <div class="container contact-inner hud">
    <h2 id="contact-heading" class="contact-heading">Hiring for backend? Let's talk.</h2>
    <p class="contact-copy">
      Looking for backend and systems roles. Email is the fastest way to reach me.
    </p>
    <a href={personal.links.email} class="contact-email">{address}</a>
    <ul class="contact-links">
      <li>
        <a href={personal.links.github} target="_blank" rel="me noreferrer">github ↗</a>
      </li>
      <li>
        <a href={personal.links.linkedin} target="_blank" rel="me noreferrer">linkedin ↗</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact-close {
    padding-top: 0;
  }

  .contact-inner {
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
  }

  .contact-heading {
    font-size: var(--text-4xl);
    line-height: 0.95;
    text-transform: uppercase;
    max-width: 18ch;
    text-wrap: balance;
  }

  .contact-copy {
    margin-top: var(--space-4);
    max-width: var(--max-measure);
    color: var(--color-text-muted);
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-6);
    font-family: var(--font-condensed);
    font-weight: 600;
    font-size: clamp(1.375rem, 1rem + 1.8vw, 2.25rem);
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .contact-email:hover {
    color: var(--color-cyan);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-4);
    list-style: none;
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-cyan);
  }

  .contact-links a:hover {
    color: var(--color-text);
  }
</style>
