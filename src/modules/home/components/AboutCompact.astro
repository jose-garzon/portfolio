---
import { about } from '../../../shared/data/about';
import { personal } from '../../../shared/data/personal';
---

<section id="about" class="section about-compact-section">
  <div class="container">

    <div class="about-compact-grid">
      <div class="about-compact-text">
        <h2 class="about-compact-heading reveal">
          <span data-text={about.heading}>{about.heading}</span>
        </h2>
        {about.paragraphs.map((paragraph) => (
          <p class="about-compact-paragraph reveal">
            {paragraph}
          </p>
        ))}

        <ul class="about-compact-skills reveal-stagger" aria-label="Tech stack">
          {about.skills.map((skill) => (
            <li class="about-compact-skill">{skill}</li>
          ))}
        </ul>
      </div>

      <aside class="about-compact-side reveal">
        <dl class="about-compact-facts">
          <div class="fact">
            <dt>Currently</dt>
            <dd>
              <ul class="fact-list">
                {about.currently.map((line) => (
                  <li>
                    {line.text}
                    {line.highlight && <strong>{` ${line.highlight}`}</strong>}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
          <div class="fact">
            <dt>Reach</dt>
            <dd>
              <a href={personal.links.email} class="fact-link">email</a>
              <span class="fact-sep" aria-hidden="true">·</span>
              <a href={personal.links.github} target="_blank" rel="noopener" class="fact-link">github</a>
              <span class="fact-sep" aria-hidden="true">·</span>
              <a href={personal.links.linkedin} target="_blank" rel="noopener" class="fact-link">linkedin</a>
            </dd>
          </div>
        </dl>
        <a href="/now" class="about-now-link">
          <span>more in /now</span>
          <span class="about-now-arrow" aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </div>
</section>

<style>
  .about-compact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-12);
    align-items: start;
  }

  .about-compact-heading {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-text);
    line-height: 0.95;
    letter-spacing: 0.01em;
    margin-bottom: var(--space-6);
  }

  .about-compact-paragraph {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: var(--max-measure);
    margin: 0 0 var(--space-5) 0;
  }

  .about-compact-paragraph:last-of-type {
    margin-bottom: var(--space-8);
  }

  .about-compact-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .about-compact-skill {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    letter-spacing: 0.02em;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .about-compact-skill:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan);
  }

  .fact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .about-compact-side {
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-8);
  }

  .about-compact-facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin: 0 0 var(--space-6) 0;
  }

  .fact dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-2);
  }

  .fact dd {
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: 1.5;
    margin: 0;
  }

  .fact dd strong {
    color: var(--color-accent);
    font-weight: 500;
  }

  .fact-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 4px;
    transition: color var(--duration-fast) ease, text-decoration-color var(--duration-fast) ease;
  }

  .fact-link:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .fact-sep {
    color: var(--color-text-subtle);
    margin-inline: var(--space-1);
  }

  .about-now-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    width: 100%;
    transition: color var(--duration-fast) ease;
  }

  .about-now-link:hover {
    color: var(--color-accent-warm);
  }

  .about-now-arrow {
    transition: transform var(--duration-normal) var(--ease-spring);
  }

  .about-now-link:hover .about-now-arrow {
    transform: translateX(3px);
  }


  .about-compact-paragraph:nth-of-type(1) { --about-d: 120ms; }
  .about-compact-paragraph:nth-of-type(2) { --about-d: 220ms; }
  .about-compact-paragraph:nth-of-type(3) { --about-d: 320ms; }
  .about-compact-side { --about-d: 260ms; }

  .about-compact-section {
    --about-d: 0ms;
  }

  .about-compact-skills > li:nth-child(1) { --about-d: 380ms; }
  .about-compact-skills > li:nth-child(2) { --about-d: 415ms; }
  .about-compact-skills > li:nth-child(3) { --about-d: 450ms; }
  .about-compact-skills > li:nth-child(4) { --about-d: 485ms; }
  .about-compact-skills > li:nth-child(5) { --about-d: 520ms; }
  .about-compact-skills > li:nth-child(6) { --about-d: 555ms; }
  .about-compact-skills > li:nth-child(7) { --about-d: 590ms; }
  .about-compact-skills > li:nth-child(8) { --about-d: 625ms; }
  .about-compact-skills > li:nth-child(9) { --about-d: 660ms; }
  .about-compact-skills > li:nth-child(10) { --about-d: 695ms; }
  .about-compact-skills > li:nth-child(11) { --about-d: 730ms; }
  .about-compact-skills > li:nth-child(12) { --about-d: 765ms; }
  .about-compact-skills > li:nth-child(n + 13) { --about-d: 800ms; }

  :global(.js) .about-compact-section .reveal.is-visible,
  :global(.js) .about-compact-skills > li.is-visible {
    animation: about-lock 900ms var(--ease-out) var(--about-d) both;
  }

  :global(.js) .about-compact-side.is-visible {
    animation: about-lock 900ms var(--ease-out) var(--about-d) both;
  }

  :global(.js) .about-compact-side.is-visible::before {
    animation: about-draw 1100ms var(--ease-out) var(--about-d) both;
  }

  .about-compact-side {
    position: relative;
  }

  .about-compact-side::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 0;
    width: 1px;
    height: 100%;
    background: var(--color-cyan);
    box-shadow: 0 0 12px rgba(0, 229, 255, 0.6);
    transform-origin: top;
  }

  @keyframes about-lock {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }

  @keyframes about-draw {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .about-compact-section .reveal.is-visible,
    :global(.js) .about-compact-skills > li.is-visible,
    :global(.js) .about-compact-side.is-visible,
    :global(.js) .about-compact-side.is-visible::before {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .about-compact-side::before {
      display: none;
    }

    .about-compact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .about-compact-side {
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding-left: 0;
      padding-top: var(--space-8);
    }
  }
</style>
