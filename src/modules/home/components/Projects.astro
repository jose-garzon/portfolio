---
import { projects } from '../../../shared/data/projects';

const ordered = [...projects.filter((p) => p.featured), ...projects.filter((p) => !p.featured)];
const [lead, ...rest] = ordered;
const hrefOf = (p: (typeof projects)[number]) => (p.slug ? `/projects/${p.slug}` : p.href);
const pad = (n: number) => n.toString().padStart(2, '0');
---

<section id="projects" class="section projects" aria-labelledby="projects-heading">
  <div class="container">
    <h2 id="projects-heading" class="section-title">Things I've built</h2>

    {
      lead && (
        <div class="lead-frame">
        <article class="lead cut">
          <div class="lead-index" aria-hidden="true">01</div>
          <div class="lead-body">
            <p class="data-tag lead-tag">featured build</p>
            <h3 class="lead-title">
              {hrefOf(lead) ? <a href={hrefOf(lead)}>{lead.name}</a> : lead.name}
            </h3>
            <p class="lead-description">{lead.description}</p>
            <ul class="lead-stack" aria-label="Stack">
              {lead.stack.map((tech) => <li>{tech}</li>)}
            </ul>
            <div class="lead-links">
              {hrefOf(lead) && (
                <a href={hrefOf(lead)} class="lead-cta cut">
                  {lead.slug ? 'Read case study' : (lead.cta ?? 'Open')}
                </a>
              )}
              {lead.github && (
                <a href={lead.github} target="_blank" rel="noopener" class="lead-link">
                  github ↗
                </a>
              )}
              {lead.live && (
                <a href={lead.live} target="_blank" rel="noopener" class="lead-link">
                  live ↗
                </a>
              )}
            </div>
          </div>
        </article>
        </div>
      )
    }

    <ol class="ledger">
      {rest.map((project, i) => (
        <li class="ledger-row">
          <span class="ledger-index">{pad(i + 2)}</span>
          <h3 class="ledger-name">
            {hrefOf(project) ? <a href={hrefOf(project)}>{project.name}</a> : project.name}
          </h3>
          <p class="ledger-description">{project.description}</p>
          <span class="ledger-stack">{project.stack.slice(0, 3).join(' · ')}</span>
          <span class="ledger-arrow" aria-hidden="true">→</span>
        </li>
      ))}
    </ol>

    <a href="/projects" class="projects-all data-tag">all projects →</a>
  </div>
</section>

<style>
  .lead-frame {
    filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.8)) drop-shadow(0 0 28px rgba(255, 45, 85, 0.22));
    transition: filter var(--duration-slow) var(--ease-out);
  }

  .lead-frame:has(.lead:hover) {
    filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.8)) drop-shadow(0 0 36px rgba(0, 229, 255, 0.11));
  }

  .lead {
    --cut: 22px;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-8);
    padding: var(--space-10) var(--space-8);
    background:
      radial-gradient(70% 120% at 0% 0%, rgba(255, 45, 85, 0.22), transparent 60%),
      radial-gradient(50% 90% at 100% 100%, rgba(0, 229, 255, 0.12), transparent 65%),
      linear-gradient(160deg, rgba(28, 28, 34, 0.7), rgba(8, 8, 10, 0.55));
    backdrop-filter: blur(22px) saturate(170%);
    -webkit-backdrop-filter: blur(22px) saturate(170%);
  }

  .lead::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    padding: 1px;
    background: linear-gradient(135deg, rgba(255, 45, 85, 0.9), rgba(238, 242, 247, 0.08) 35%, rgba(238, 242, 247, 0.05) 65%, rgba(0, 229, 255, 0.8));
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }

  .lead::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.25) 2px 3px);
    pointer-events: none;
  }

  .lead-index {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 7rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-cyan);
    filter: drop-shadow(0 0 10px rgba(0, 229, 255, 0.7)) drop-shadow(0 0 28px rgba(0, 229, 255, 0.35));
  }

  .lead-tag {
    color: var(--color-text-subtle);
    margin-bottom: var(--space-2);
  }

  .lead-title {
    text-shadow: 0 0 0.5em rgba(238, 242, 247, 0.25);
    font-size: var(--text-4xl);
    line-height: 0.95;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .lead-title a:hover {
    color: var(--color-cyan);
  }

  .lead-description {
    max-width: var(--max-measure);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .lead-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .lead-stack li {
    padding: var(--space-1) var(--space-2);
    background: rgba(238, 242, 247, 0.04);
    border: 1px solid rgba(238, 242, 247, 0.12);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .lead-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .lead-cta {
    --cut: 10px;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-3) var(--space-5);
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    text-transform: uppercase;
    transition: background var(--duration-fast) ease;
  }

  .lead-cta:hover {
    background: var(--color-cyan);
  }

  .lead-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-cyan);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .ledger {
    list-style: none;
    margin-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .ledger-row {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(10rem, 1fr) minmax(0, 2fr) auto auto;
    align-items: baseline;
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-fast) ease;
  }

  .ledger-row:hover {
    background: var(--color-surface);
  }

  .ledger-row:hover .ledger-name a,
  .ledger-row:hover .ledger-arrow {
    color: var(--color-cyan);
  }

  .ledger-index {
    font-family: var(--font-pixel);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .ledger-name {
    font-family: var(--font-condensed);
    font-weight: 600;
    font-size: var(--text-xl);
  }

  .ledger-name a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .ledger-description {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .ledger-stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    white-space: nowrap;
  }

  .ledger-arrow {
    font-family: var(--font-mono);
    color: var(--color-text-subtle);
  }

  .projects-all {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-6);
    color: var(--color-cyan);
  }

  .projects-all:hover {
    color: var(--color-text);
  }

  @media (max-width: 860px) {
    .ledger-row {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    }

    .ledger-description,
    .ledger-stack {
      grid-column: 2 / -1;
    }
  }

  @media (max-width: 640px) {
    .lead {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-6);
      gap: var(--space-4);
    }
  }
</style>
