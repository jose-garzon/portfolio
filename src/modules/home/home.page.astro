---
import Layout from '../../layouts/Layout.astro';
import { fullName } from '../../shared/data/personal';
import AboutCompact from './components/AboutCompact.astro';
import ContactClose from './components/ContactClose.astro';
import Hero from './components/Hero.astro';
import Projects from './components/Projects.astro';
---

<Layout
  title={`${fullName} · Software Engineer`}
  description="Software engineer digging down the stack. Five years of production work, now going deeper into how computers work and where they hit their limits. Writing in public as I go."
>
  <main id="main">
    <Hero />
    <Projects />
    <AboutCompact />
    <ContactClose />
  </main>
</Layout>
